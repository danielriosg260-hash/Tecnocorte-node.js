<%# Título: Horarios y bloqueos - TecnoCorte %>

<%- include('../partials/admin-sidebar', { active: "horarios" }) %>
<main class="ml-0 md:ml-64 flex-1 min-h-screen p-8 md:p-12 pb-24 md:pb-12 bg-surface">
  <%- include('../partials/panel-header') %>
  <header class="mb-10">
    <h1 class="font-headline text-4xl text-primary">Horarios de atención</h1>
    <p class="text-on-surface-variant mt-2">
      Elige los días laborales y el horario en el que se pueden agendar citas
      por peluquería.
    </p>
  </header>

  <div class="mb-8 flex flex-wrap gap-3">
    
    <% var _lista21 = (peluquerias || []); if (_lista21.length) { _lista21.forEach(function (p, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista21.length - 1 }; var _finDeLista = _lista21.length - 1; %>
    <a
      href="?peluqueria=<%= p.id %>"
      class="px-5 py-2.5 rounded-full text-sm font-bold border border-outline-variant/20 transition-all duration-200 <% if (peluqueria_actual && peluqueria_actual.id == p.id) { %>bg-gradient-to-br from-primary to-primary-container text-on-primary border-transparent shadow-[0_0_20px_rgba(242,202,80,0.2)]<% } else { %>bg-surface-container-high text-on-surface-variant hover:border-primary hover:text-primary<% } %>"
      ><%= p.nombre %></a
    >
    <% }); } %>
  </div>

  <% if (peluqueria_actual) { %>
  <section class="bg-surface-container-low rounded-xl p-6 mb-8">
    <h2 class="font-headline text-2xl mb-5">Días de trabajo</h2>
    <form method="post">
      
      <input type="hidden" name="accion" value="guardar_horarios" />
      <input
        type="hidden"
        name="peluqueria_seleccionada"
        value="<%= peluqueria_actual.id %>"
      />
      <div class="table-responsive">
        
        <table class="w-full text-sm">
          <thead class="text-on-surface-variant uppercase text-xs">
            <tr>
              <th class="text-left pb-3">Día</th>
              <th class="text-left pb-3">Se trabaja</th>
              <th class="text-left pb-3">Desde</th>
              <th class="text-left pb-3">Hasta</th>
            </tr>
          </thead>
          <tbody>
            <% var _lista22 = (horarios || []); if (_lista22.length) { _lista22.forEach(function (horario, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista22.length - 1 }; var _finDeLista = _lista22.length - 1; %>
            <tr class="border-t border-outline-variant/20">
              <td class="py-4 font-semibold">
                <%= horario.dia_semana_display %>
              </td>
              <td>
                <input
                  type="checkbox"
                  name="activo_<%= horario.dia_semana %>"
                  <% if (horario.activo) { %>checked<% } %>
                  class="rounded text-primary focus:ring-primary"
                />
              </td>
              <td>
                <input
                  type="time"
                  name="inicio_<%= horario.dia_semana %>"
                  value="<%= fmtHora(horario.hora_inicio) %>"
                  class="bg-surface-container-high border-0 rounded px-3 py-2 text-on-surface"
                />
              </td>
              <td>
                <input
                  type="time"
                  name="fin_<%= horario.dia_semana %>"
                  value="<%= fmtHora(horario.hora_fin) %>"
                  class="bg-surface-container-high border-0 rounded px-3 py-2 text-on-surface"
                />
              </td>
            </tr>
            <% }); } %>
          </tbody>
        </table>
      </div>
      <button
        class="mt-6 btn-gold-gradient font-bold px-5 py-3 rounded-md"
        type="submit"
      >
        Guardar horarios
      </button>
    </form>
  </section>

  <section class="grid lg:grid-cols-2 gap-8">
    <div class="bg-surface-container-low rounded-xl p-6">
      <h2 class="font-headline text-2xl mb-2">Bloquear fecha u hora</h2>
      
      <p class="text-on-surface-variant text-sm mb-5">
        Si dejas la hora vacía, se bloquea el día completo.
      </p>
      <form method="post" class="space-y-4">
        
        <input type="hidden" name="accion" value="crear_bloqueo" />
        <input
          type="hidden"
          name="peluqueria_seleccionada"
          value="<%= peluqueria_actual.id %>"
        />
        <input
          required
          min="<%= fmtFecha(hoy, "Y-m-d") %>"
          type="date"
          name="fecha"
          class="w-full bg-surface-container-high border-0 rounded px-3 py-3 text-on-surface"
        />
        <input
          type="time"
          name="hora"
          class="w-full bg-surface-container-high border-0 rounded px-3 py-3 text-on-surface"
        />
        <input
          type="text"
          name="motivo"
          placeholder="Motivo (opcional)"
          class="w-full bg-surface-container-high border-0 rounded px-3 py-3 text-on-surface"
        />
        <button
          class="border border-primary text-primary font-bold px-5 py-3 rounded-md hover:bg-primary hover:text-on-primary"
          type="submit"
        >
          Bloquear
        </button>
      </form>
    </div>
    <div class="bg-surface-container-low rounded-xl p-6">
      <h2 class="font-headline text-2xl mb-5">Bloqueos programados</h2>
      
      <div class="space-y-3">
        <% var _lista23 = (bloqueos || []); if (_lista23.length) { _lista23.forEach(function (bloqueo, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista23.length - 1 }; var _finDeLista = _lista23.length - 1; %>
        <div
          class="flex justify-between items-center bg-surface-container-high p-3 rounded"
        >
          <div>
            <strong><%= fmtFecha(bloqueo.fecha, "d/m/Y") %></strong><% if (bloqueo.hora) { %> · <%= fmtHora(bloqueo.hora) %><% } else { %> · Día completo<% } %>
            <p class="text-xs text-on-surface-variant">
              <%= ((bloqueo.motivo === undefined || bloqueo.motivo === null || bloqueo.motivo === '') ? "Sin motivo" : bloqueo.motivo) %>
            </p>
          </div>
          <form
            method="post"
            action="<%= `/admin/horarios/bloqueos/${bloqueo.id}/eliminar` %>"
          >
            <button
              type="submit"
              class="text-error text-sm"
              data-confirm="¿Quitar este bloqueo?"
            >
              Quitar
            </button>
          </form>
        </div>
        <% }); } else { %>
        <p class="text-on-surface-variant">No hay bloqueos registrados.</p>
        <% } %>
      </div>
    </div>
  </section>
  <% } else { %>
  <div class="bg-surface-container-low rounded-xl p-12 text-center">
    <p class="text-on-surface-variant text-lg">
      Selecciona una peluquería para configurar sus horarios.
    </p>
  </div>
  <% } %>
</main>
<%- include('../partials/admin-mobile-nav', { active: "horarios" }) %>


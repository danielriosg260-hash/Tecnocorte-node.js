<% // Layout: dashboard %>
<%- include('../partials/admin-sidebar', { active: 'reservas' }) %>
<main class="ml-64 flex-1 min-h-screen p-12 bg-surface">
<!-- Header -->
<header class="flex justify-between items-end mb-16">
<div>
<h2 class="font-headline text-4xl text-on-background tracking-tight"><% if (datos) { %>Editar<% } else { %>Crear<% } %> Reserva</h2>
<p class="font-body text-on-surface-variant mt-2">Agenda una cita para un cliente.</p>
</div>
<a href="/admin/reservas" class="flex items-center gap-2 text-primary uppercase tracking-widest text-sm font-bold hover:text-primary-container transition-colors active:scale-95"><span class="material-symbols-outlined text-base">arrow_back</span>Volver</a>
</header>
<!-- Form Card -->
<div class="bg-surface-container-low rounded-lg ambient-shadow p-10 max-w-2xl">
<form method="post" class="grid gap-6">
<!-- csrf: auth JWT -->
<% if (error) { %><p class="rounded-md bg-error-container/20 border border-error/40 text-error p-3"><%= error %></p><% } %>
<div class="grid gap-2">
<label class="font-label text-xs uppercase tracking-widest text-on-surface-variant">Cliente</label>
<select name="cliente" required class="w-full bg-surface-container-highest border border-outline-variant/20 text-on-surface rounded-lg px-4 py-3 focus:ring-0 focus:border-primary transition-colors">
<option value="" class="bg-surface-container-high">Seleccione un cliente</option>
<% if (clientes) { clientes.forEach(function(cliente) { %>
<option value="<%= cliente.id %>" class="bg-surface-container-high" <% if (datos && datos.cliente_id == cliente.id) { %>selected<% } %>><%= cliente.nombre %> <%= cliente.apellido %></option>
<% }); } %>
</select>
</div>
<div class="grid gap-2">
<label class="font-label text-xs uppercase tracking-widest text-on-surface-variant">Servicio</label>
<select name="servicio" class="w-full bg-surface-container-highest border border-outline-variant/20 text-on-surface rounded-lg px-4 py-3">
<% if (servicios) { servicios.forEach(function(servicio) { %>
<option value="<%= servicio.nombre %>" <% if (datos && datos.servicio === servicio.nombre) { %>selected<% } %>><%= servicio.nombre %> (<%= servicio.duracion %>)</option>
<% }); } %>
</select>
</div>
<div class="grid gap-2">
<label class="font-label text-xs uppercase tracking-widest text-on-surface-variant">Barbero</label>
<select name="peluquero" required class="w-full bg-surface-container-highest border border-outline-variant/20 text-on-surface rounded-lg px-4 py-3 focus:ring-0 focus:border-primary transition-colors">
<option value="" class="bg-surface-container-high">Seleccione un barbero</option>
<% if (peluqueros) { peluqueros.forEach(function(peluquero) { %>
<option value="<%= peluquero.id %>" class="bg-surface-container-high" <% if (datos && datos.peluquero_id == peluquero.id) { %>selected<% } %>><%= peluquero.nombre %> <%= peluquero.apellido %></option>
<% }); } %>
</select>
</div>
<div class="grid gap-2">
<label class="font-label text-xs uppercase tracking-widest text-on-surface-variant">Peluquería</label>
<select name="peluqueria" required class="w-full bg-surface-container-highest border border-outline-variant/20 text-on-surface rounded-lg px-4 py-3 focus:ring-0 focus:border-primary transition-colors">
<option value="" class="bg-surface-container-high">Seleccione una peluquería</option>
<% if (peluquerias) { peluquerias.forEach(function(peluqueria) { %>
<option value="<%= peluqueria.id %>" class="bg-surface-container-high" <% if (datos && datos.peluqueria_id == peluqueria.id) { %>selected<% } %>><%= peluqueria.nombre %></option>
<% }); } %>
</select>
</div>
<div class="grid grid-cols-2 gap-6">
<div class="grid gap-2">
<label class="font-label text-xs uppercase tracking-widest text-on-surface-variant">Fecha</label>
<input type="date" name="fecha" required value="<%= datos ? datos.fecha || '' : '' %>" class="w-full bg-surface-container-highest border border-outline-variant/20 text-on-surface rounded-lg px-4 py-3 focus:ring-0 focus:border-primary transition-colors">
</div>
<div class="grid gap-2">
<label class="font-label text-xs uppercase tracking-widest text-on-surface-variant">Hora</label>
<input type="time" name="hora" required value="<%= datos ? datos.hora || '' : '' %>" class="w-full bg-surface-container-highest border border-outline-variant/20 text-on-surface rounded-lg px-4 py-3 focus:ring-0 focus:border-primary transition-colors">
</div>
</div>
<div class="grid gap-2">
<label class="font-label text-xs uppercase tracking-widest text-on-surface-variant">Estado</label>
<select name="estado" class="w-full bg-surface-container-highest border border-outline-variant/20 text-on-surface rounded-lg px-4 py-3 focus:ring-0 focus:border-primary transition-colors">
<% if (reserva_estados) { reserva_estados.forEach(function(estado) { %>
<option value="<%= estado[0] %>" class="bg-surface-container-high" <% if (datos && datos.estado === estado[0]) { %>selected<% } %>><%= estado[1] %></option>
<% }); } %>
</select>
</div>
<div class="pt-2">
<button type="submit" class="btn-gold-gradient font-label uppercase tracking-widest text-sm font-bold py-4 px-10 rounded-md hover:opacity-90 transition-opacity active:scale-95">Guardar Reserva</button>
</div>
</form>
</div>
<div class="signature-divider mt-12"></div>
</main>

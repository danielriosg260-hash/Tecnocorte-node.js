<% // Layout: dashboard %>
<%- include('../partials/admin-sidebar', { active: 'notificaciones' }) %>
<main class="ml-64 min-h-screen flex-1 bg-surface p-8 md:p-12">
  <header class="mb-10">
    <h1 class="font-headline text-4xl text-primary">Notificaciones</h1>
    <p class="mt-2 text-on-surface-variant">Avisos importantes del inventario y la operación.</p>
  </header>
  <section class="max-w-3xl space-y-4">
    <% if (notificaciones && notificaciones.length) { notificaciones.forEach(function(notificacion) { %>
    <article class="flex gap-4 rounded-xl border border-error/20 bg-error-container/10 p-5">
      <span class="material-symbols-outlined mt-0.5 text-error">inventory_2</span>
      <div>
        <p class="font-semibold text-on-surface"><%= notificacion.mensaje %></p>
        <p class="mt-1 text-xs text-on-surface-variant"><%= fmtFecha(notificacion.fecha, 'dd/MM/yyyy HH:mm') %></p>
      </div>
    </article>
    <% }); } else { %>
    <div class="rounded-xl bg-surface-container-low p-10 text-center text-on-surface-variant">
      No tienes notificaciones nuevas.
    </div>
    <% } %>
  </section>
</main>
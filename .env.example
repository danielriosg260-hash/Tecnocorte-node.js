# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3026

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS MONGODB
# ==========================================
# Ejemplo para desarrollo local: mongodb://localhost:27017/tecnocorte
# Puedes usar MONGO_URI, MONGODB_URI o DATABASE_URL. En Render configura una sola.
# Ejemplo para MongoDB Atlas: mongodb+srv://usuario:contraseña@cluster.mongodb.net/tecnocorte?retryWrites=true&w=majority
DATABASE_URL=
MONGO_URI=

# ==========================================
# CONFIGURACIÓN DE EMAIL (GMAIL)
# ==========================================
# Para usar Gmail, debes:
# 1. Habilitar la autenticación de dos factores en tu cuenta de Google
# 2. Generar una "Contraseña de aplicación" desde: https://myaccount.google.com/apppasswords
# 3. Usar esa contraseña aquí (NO la contraseña de tu cuenta)
EMAIL_USER=
EMAIL_PASS=

# ==========================================
# CONFIGURACIÓN DE JWT (JSON WEB TOKENS)
# ==========================================
# JWT_SECRET: Clave secreta para firmar los tokens (usa una cadena larga y aleatoria)
# JWT_EXPIRE: Tiempo de expiración del token (ej: 7d, 24h, 30d)
JWT_SECRET=
JWT_EXPIRE=7d

NODE_ENV=development
APP_URL=http://localhost:3026

<%- include('../partials/admin-sidebar', { active: 'galeria' }) %>
<main class="ml-64 flex-1 p-12 space-y-8"><h1 class="font-headline text-4xl text-primary">Galería de peluquerías</h1><form method="post" enctype="multipart/form-data" class="grid gap-3 max-w-2xl"><select name="peluqueria" required class="rounded-md p-3"><% peluquerias.forEach((p) => { %><option value="<%= p._id %>"><%= p.nombre %></option><% }) %></select><input type="file" name="foto" accept="image/jpeg,image/png,image/webp" class="rounded-md p-3"><input name="url" placeholder="O URL de la imagen" class="rounded-md p-3"><input name="descripcion" placeholder="Descripción" class="rounded-md p-3"><button class="rounded-md bg-primary p-3 font-bold text-on-primary">Agregar imagen</button></form><section class="grid gap-4 md:grid-cols-3"><% imagenes.forEach((imagen) => { %><article class="rounded-xl border border-outline-variant/20 p-3"><img src="<%= imagen.url %>" alt="<%= imagen.descripcion %>" class="h-40 w-full object-cover"><p><%= imagen.peluqueria?.nombre || '' %></p><form method="post" action="/admin/galeria/<%= imagen._id %>/eliminar"><button class="text-error">Eliminar</button></form></article><% }) %></section></main>

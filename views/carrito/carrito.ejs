<!doctype html>
<!-- Página standalone del carrito de compras con lista de productos y resumen -->
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Carrito - TecnoCorte</title>
    <%- include('../partials/favicon') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;family=Noto+Serif:ital,wght@0,400;0,700;1,400&amp;display=swap"
      rel="stylesheet"
    />
    <%- include('../partials/tema') %>
    <link rel="stylesheet" href="/css/carrito/carrito.css" />
  </head>

  <body class="bg-surface text-on-surface font-body antialiased">
    <%- include('../partials/site-nav', { active: "tienda" }) %>
    <!-- TopNavBar -->
    <nav class="hidden">
      <div
        class="flex justify-between items-center w-full px-8 py-4 max-w-full mx-auto"
      >
        <a
          class="inline-flex"
          href="/tienda"
          aria-label="TecnoCorte"
          ><%- include('../partials/logo') %></a
        >
        <div
          class="hidden md:flex space-x-8 items-center font-display text-on-surface uppercase tracking-widest text-sm"
        >
          <a
            class="text-on-surface-variant hover:text-primary transition-all duration-300"
            href="/servicios"
            >Servicios</a
          ><a
            class="text-primary border-b-2 border-primary pb-1"
            href="/tienda"
            >Tienda</a
          ><a
            class="text-on-surface-variant hover:text-primary transition-all duration-300"
            href="/peluquerias"
            >Peluquerías</a
          ><a
            class="text-on-surface-variant hover:text-primary transition-all duration-300"
            href="/ayuda"
            >Contactos</a
          >
        </div>
        <div class="flex items-center space-x-6">
          <button
            data-theme-toggle
            onclick="toggleTheme()"
            class="text-primary transition-all duration-300 hover:text-primary-container active:scale-90"
            title="Activar tema claro"
            type="button"
          >
            <span class="material-symbols-outlined theme-icon"
              >light_mode</span
            ></button
          ><%- include('../partials/notificaciones-indicator') %><% if (logueado) { %><a
            href="/perfil"
            class="text-on-surface-variant hover:text-primary transition-colors font-bold uppercase tracking-widest"
            >Perfil</a
          ><a
            href="/logout"
            class="text-on-surface-variant hover:text-primary transition-colors font-bold uppercase tracking-widest"
            >Salir</a
          ><% } else { %><a
            href="/login"
            class="text-on-surface-variant hover:text-primary transition-colors font-bold uppercase tracking-widest"
            >Ingresar</a
          ><% } %><%- include('../partials/carrito-indicator') %>
        </div>
      </div>
    </nav>
    <!-- Main -->
    <main class="pt-32 pb-24 px-4 md:px-12 max-w-6xl mx-auto min-h-screen">
      <header
        class="mb-12 flex flex-col md:flex-row justify-between items-end gap-6"
      >
        <div>
          <h1
            class="font-headline text-5xl md:text-6xl font-black tracking-tight text-on-surface mb-4"
          >
            Tu
            <span class="gold-gradient-bg bg-clip-text text-transparent"
              >Carrito</span
            >
          </h1>
          <p class="font-body text-on-surface-variant max-w-lg">
            Revisa los productos antes de finalizar tu compra. Tu carrito se
            guarda aunque cierres sesión.
          </p>
        </div>
        <a
          href="/tienda"
          class="flex items-center gap-2 text-primary uppercase tracking-widest text-sm font-bold hover:text-primary-container transition-colors active:scale-95"
          ><span class="material-symbols-outlined text-base">arrow_back</span
          >Seguir comprando</a
        >
      </header>
      
      <% if (items) { %>
      <div class="flex flex-col lg:flex-row gap-10">
        <!-- Items List -->
        <div class="flex-1 space-y-6" id="cart-items">
          <% var _lista42 = (items || []); if (_lista42.length) { _lista42.forEach(function (item, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista42.length - 1 }; var _finDeLista = _lista42.length - 1; %>
          <div
            class="tc-glass tc-cart-item rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center gap-6 group"
            data-cart-item="<%= item.producto.id %>"
          >
            <div class="tc-cart-thumb">
              <% if (item.producto.imagen) { %><img
                src="<%= item.producto.imagen %>"
                alt="<%= item.producto.nombre %>"
              /><% } else { %><span
                class="material-symbols-outlined text-primary/40 text-4xl"
                >content_cut</span
              ><% } %>
            </div>
            <div class="flex-1 min-w-0">
              <span
                class="text-[10px] uppercase tracking-widest text-primary block mb-1"
                ><%= item.producto.categoria_display %>
              </span>
              <h3 class="font-headline text-xl text-on-surface mb-1">
                <%= item.producto.nombre %>
              </h3>
              <p class="text-on-surface-variant text-sm">
                $<%= Number(Number(item.producto.precio) || 0).toFixed(1) %> COP c/u
              </p>
            </div>
            <div class="flex flex-col items-end gap-4">
              <div
                class="flex items-center gap-3 bg-surface-container-highest rounded-lg p-1"
              >
                <form
                  method="post"
                  action="<%= `/carrito/actualizar/${item.producto.id}` %>"
                  class="cart-update-form"
                  data-sin-cargando
                >
                  
                  <input type="hidden" name="accion" value="decrementar" />
                  <input type="hidden" name="cantidad" value="<%= (Number(item.cantidad) || 0) + -1 %>" />
                  <button
                    class="text-primary hover:text-primary-container transition-colors active:scale-90 p-1"
                    type="submit"
                    title="Menos"
                  >
                    <span class="material-symbols-outlined text-base"
                      >remove</span
                    >
                  </button>
                </form>
                <span
                  class="text-on-surface font-bold min-w-[2rem] text-center"
                  data-cart-quantity
                  ><%= item.cantidad %></span
                >
                <form
                  method="post"
                  action="<%= `/carrito/actualizar/${item.producto.id}` %>"
                  class="cart-update-form"
                  data-sin-cargando
                >
                  
                  <input type="hidden" name="accion" value="incrementar" />
                  <input type="hidden" name="cantidad" value="<%= (Number(item.cantidad) || 0) + 1 %>" />
                  <button
                    class="text-primary hover:text-primary-container transition-colors active:scale-90 p-1"
                    type="submit"
                    title="Más"
                  >
                    <span class="material-symbols-outlined text-base">add</span>
                  </button>
                </form>
              </div>
              <span
                class="font-headline text-lg text-primary"
                data-cart-subtotal
                >$<%= Number(Number(item.subtotal) || 0).toFixed(1) %>
              </span>
              <form
                method="post"
                action="<%= `/carrito/eliminar/${item.producto.id}` %>"
                class="cart-remove-form"
                data-sin-cargando
              >
                
                <button
                  class="text-error hover:text-error/80 transition-colors text-xs uppercase tracking-widest font-semibold active:scale-95"
                  type="submit"
                >
                  Eliminar
                </button>
              </form>
            </div>
          </div>
          <% }); } %>
        </div>
        
        <!-- Summary -->
        <aside class="lg:w-80 shrink-0">
          <div class="tc-glass rounded-2xl p-8 sticky top-32">
            <h3
              class="font-headline text-2xl text-primary-container mb-6 border-b border-outline-variant/20 pb-4"
            >
              Resumen
            </h3>
            <div class="flex justify-between items-center mb-4">
              <span class="text-on-surface-variant text-sm">Productos</span
              ><span
                class="text-on-surface font-semibold"
                id="cart-total-quantity"
                ><%= ((cantidad === undefined || cantidad === null || cantidad === '') ? "0" : cantidad) %>
              </span>
            </div>
            <div
              class="flex justify-between items-end mb-8 pt-4 border-t border-outline-variant/20"
            >
              <span class="text-on-surface-variant text-sm">Total</span
              ><span
                class="font-headline text-3xl text-primary"
                id="cart-total-price"
                >$<%= Number(Number(((total === undefined || total === null || total === '') ? "0" : total)) || 0).toFixed(1) %>
              </span>
            </div>
            <% if (logueado && logueado.rol == 'Cliente') { %><a
              href="/carrito/finalizar"
              class="w-full inline-flex justify-center py-4 rounded-md gold-gradient-bg text-on-primary font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all active:scale-95"
              >Finalizar Compra</a
            ><% } else if (logueado) { %><p
              class="text-xs text-on-surface-variant mt-4 text-center"
            >
              Solo los clientes pueden finalizar compras. Puedes consultar este
              espacio libremente.
            </p>
            <% } else { %><a
              href="/login?next=/carrito/"
              class="w-full inline-flex justify-center py-4 rounded-md gold-gradient-bg text-on-primary font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all active:scale-95"
              >Iniciar Sesión para Comprar</a
            >
            <p class="text-xs text-on-surface-variant mt-4 text-center">
              Al iniciar sesión o registrarte tu carrito se conserva.
            </p>
            <% } %><a
              href="/tienda"
              class="mt-4 w-full inline-flex justify-center py-3 rounded-md border border-outline-variant/30 text-primary hover:border-primary transition-colors text-sm font-semibold uppercase tracking-widest active:scale-95"
              >Seguir comprando</a
            >
          </div>
        </aside>
      </div>
      <% } else { %>
      <div
        class="text-center py-24 bg-surface-container-low rounded-xl ghost-border"
      >
        <span
          class="material-symbols-outlined text-primary/40 text-6xl mb-6"
          style="font-variation-settings: &quot;FILL&quot; 1"
          >shopping_bag</span
        >
        <h2 class="font-headline text-3xl text-on-surface mb-3">
          Tu carrito está vacío
        </h2>
        <p class="text-on-surface-variant mb-10 max-w-md mx-auto">
          Explora la tienda y agrega productos para tu cuidado personal.
        </p>
        <a
          href="/tienda"
          class="inline-flex justify-center py-4 px-10 rounded-md gold-gradient-bg text-on-primary font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all active:scale-95"
          >Ir a la tienda</a
        >
      </div>
      <% } %>
    </main>
    <footer
      class="flex w-full flex-col items-center gap-8 border-t border-outline-variant/10 bg-surface-container-lowest px-8 pb-8 pt-16"
    >
      <div class="font-headline text-xl font-bold text-primary">TecnoCorte</div>
      <nav
        class="flex flex-wrap justify-center gap-6 text-sm text-on-surface-variant"
      >
        <a
          class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100"
          href="/politicas"
          >Privacidad</a
        >
          <a class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100" href="/politicas">Políticas de Privacidad y del Proyecto</a>
        <a
          class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100"
          href="/ayuda"
          >Términos</a
        >
        <a
          class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100"
          href="/ayuda"
          >Soporte</a
        >
        <a
          class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100"
          href="/ayuda"
          >Franquicias</a
        >
      </nav>
      <div class="mt-4 text-center text-sm text-on-surface-variant opacity-60">
        © 2026 TecnoCorte. Todos los derechos reservados.
      </div>
    </footer>
    <script>
      // Lógica AJAX para actualizar, eliminar productos y refrescar el resumen
      (function () {
        var tiendaUrl = "/tienda";
        function money(value) {
          return "$" + Number(value || 0).toLocaleString("es-CO");
        }

        function updateSummary(data) {
          // El indicador del carrito usa la clase .cart-count (no un id).
          var counts = document.querySelectorAll(".cart-count");
          var quantity = document.getElementById("cart-total-quantity");
          var total = document.getElementById("cart-total-price");
          counts.forEach(function (count) {
            count.textContent = data.cantidad;
          });
          if (quantity) quantity.textContent = data.cantidad;
          if (total) total.textContent = money(data.total);
        }

        function showEmptyCart() {
          var items = document.getElementById("cart-items");
          var aside = document.querySelector("#cart-items + aside");
          if (items)
            items.innerHTML =
              '<div class="text-center py-16 bg-surface-container-low rounded-xl ghost-border"><span class="material-symbols-outlined text-primary/40 text-5xl mb-4 block">shopping_bag</span><h2 class="font-headline text-3xl text-on-surface mb-3">Tu carrito está vacío</h2><p class="text-on-surface-variant mb-8">Explora la tienda y agrega productos para tu cuidado personal.</p><a href="' +
              tiendaUrl +
              '" class="inline-flex justify-center py-3 px-8 rounded-md gold-gradient-bg text-on-primary font-bold text-sm uppercase tracking-widest">Ir a la tienda</a></div>';
          if (aside) aside.style.display = "none";
        }

        function sendCartForm(form, remove) {
          var buttons = form.querySelectorAll("button");
          buttons.forEach(function (button) {
            button.disabled = true;
          });
          fetch(form.action, {
            method: "POST",
            body: new URLSearchParams(new FormData(form)),
            headers: {
              "X-Requested-With": "XMLHttpRequest",
            },
          })
            .then(function (response) {
              return response.json().then(function (data) {
                if (!response.ok)
                  throw new Error(
                    data.error || "No se pudo actualizar el carrito.",
                  );
                return data;
              });
            })
            .then(function (data) {
              var item = form.closest("[data-cart-item]");
              updateSummary(data);
              if (remove || data.item_cantidad === 0) {
                if (item) item.remove();
                if (data.empty) showEmptyCart();
                if (window.TecnoCorteNotify)
                  window.TecnoCorteNotify.info(
                    "Producto eliminado del carrito.",
                  );
                return;
              }
              if (item) {
                var quantity = item.querySelector("[data-cart-quantity]");
                var subtotal = item.querySelector("[data-cart-subtotal]");
                var updateForms = item.querySelectorAll(".cart-update-form");
                if (quantity) quantity.textContent = data.item_cantidad;
                if (subtotal) subtotal.textContent = money(data.subtotal);
                if (updateForms[0])
                  updateForms[0].querySelector("input[name=cantidad]").value =
                    Math.max(data.item_cantidad - 1, 0);
                if (updateForms[1])
                  updateForms[1].querySelector("input[name=cantidad]").value =
                    data.item_cantidad + 1;
              }
              if (window.TecnoCorteNotify) {
                if (data.mensaje) window.TecnoCorteNotify.warning(data.mensaje);
                else window.TecnoCorteNotify.success("Carrito actualizado.");
              }
            })
            .catch(function (error) {
              if (window.TecnoCorteNotify)
                window.TecnoCorteNotify.error(error.message);
            })
            .finally(function () {
              buttons.forEach(function (button) {
                button.disabled = false;
              });
            });
        }

        document.addEventListener("submit", function (event) {
          var form = event.target;
          var remove = form.classList.contains("cart-remove-form");
          if (!remove && !form.classList.contains("cart-update-form")) return;
          event.preventDefault();
          sendCartForm(form, remove);
        });
      })();
    </script>
  </body>
</html>


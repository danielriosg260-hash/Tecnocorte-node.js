<!-- Plantilla base principal: estructura HTML, estilos globales, header, footer y contenido -->
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' && title ? title : 'TecnoCorte' %></title>
    <%- include('../partials/favicon') %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Noto+Serif:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <%# Las páginas que heredan esta plantilla usan las clases de Tailwind del header y footer. %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <%# Sistema de temas (variables CSS, Tailwind y botón de cambio) %>
    <%- include('../partials/tema') %>
    <%# Estilos globales del sitio %>
    <link rel="stylesheet" href="/css/base/base.css" />
    <%# Estilos adicionales de cada página %>
    <%- typeof styles !== 'undefined' ? styles : '' %>
  </head>
  <body>
    <%# Barra de navegación principal del sitio %>
    <%- include('../partials/site-nav', { active: typeof active !== 'undefined' ? active : '' }) %>
    <div class="page">
      <%# Header antiguo, oculto cuando la pill-nav está activa %>
      <header class="hidden">
        <div class="brand">
          <%- include('../partials/logo') %>
          <p>Reservas de citas y productos para tu barbería.</p>
        </div>
        <nav>
          <a href="/">Inicio</a>
          <a href="/login">Login</a>
          <%- include('../partials/carrito-indicator') %>
          <button
            class="theme-toggle-btn"
            data-theme-toggle
            aria-label="Activar tema claro"
            aria-pressed="true"
            onclick="toggleTheme()"
            title="Activar tema claro"
            type="button"
          >
            <span class="material-symbols-outlined theme-icon">light_mode</span>
          </button>
        </nav>
      </header>
      <%# Contenido principal de cada página %>
      <section class="card"><%- body %></section>
      <%# Pie de página con enlaces de soporte y copyright %>
      <footer class="flex w-full flex-col items-center gap-8 border-t border-outline-variant/10 bg-surface-container-lowest px-8 pb-8 pt-16">
        <div class="font-headline text-xl font-bold text-primary">TecnoCorte</div>
        <nav class="flex flex-wrap justify-center gap-6 text-sm text-on-surface-variant">
          <a class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100" href="/politicas">Privacidad</a>
          <a class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100" href="/politicas">Políticas de Privacidad y del Proyecto</a>
          <a class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100" href="/ayuda">Términos</a>
          <a class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100" href="/ayuda">Soporte</a>
          <a class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100" href="/ayuda">Franquicias</a>
        </nav>
        <div class="mt-4 text-center text-sm text-on-surface-variant opacity-60">
          © 2026 TecnoCorte. Todos los derechos reservados.
        </div>
      </footer>
    </div>
    <%# Sistema de carga global %>
    <%- include('../partials/loading') %>
  </body>
</html>

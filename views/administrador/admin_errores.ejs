<%- include('../partials/admin-sidebar', { active: 'errores' }) %>
<main class="ml-64 flex-1 p-12"><h1 class="font-headline text-4xl text-primary mb-8">Registro de errores</h1><div class="space-y-4"><% errores.forEach((error) => { %><article class="rounded-xl border border-outline-variant/20 p-5 <%= error.revisado ? 'opacity-60' : '' %>"><div class="flex flex-wrap justify-between gap-3"><strong><%= error.codigo %> · HTTP <%= error.codigo_http %></strong><span><%= fmtFecha(error.createdAt, 'dd/MM/yyyy HH:mm') %></span></div><p class="mt-2"><%= error.tipo %>: <%= error.mensaje %></p><p class="text-sm text-on-surface-variant"><%= error.metodo %> <%= error.ruta %> · <%= error.ip %></p><% if (!error.revisado) { %><form method="post" action="/admin/errores/<%= error._id %>/revisar" class="mt-3"><button class="rounded bg-primary px-3 py-2 text-on-primary">Marcar revisado</button></form><% } %></article><% }) %></div></main>

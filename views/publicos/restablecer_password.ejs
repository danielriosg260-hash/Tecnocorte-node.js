<%# Título: Cambiar contraseña -
TecnoCorte %>

<link rel="stylesheet" href="/css/publicos/restablecer_password.css" />


<div class="password-reset">
  <span
    class="material-symbols-outlined"
    style="font-size: 3rem; color: var(--gold)"
    >password</span
  >
  
  <% if (valido) { %>
  <h1>Cambiar contraseña</h1>
  <p>Elige una nueva contraseña segura para tu cuenta.</p>
  <% if (error) { %>
  <div class="error" role="alert"><%= error %></div>
  <% } %>
  <!-- Formulario para ingresar la nueva contraseña dos veces -->
  <form method="post">
    
    <label for="new-password">Nueva contraseña</label>
    <input
      id="new-password"
      name="password"
      type="password"
      required
      minlength="8"
      autocomplete="new-password"
    />
    <label for="confirm-password">Repite la contraseña</label>
    <input
      id="confirm-password"
      name="password_confirm"
      type="password"
      required
      minlength="8"
      autocomplete="new-password"
    />
    <button type="submit">Guardar contraseña</button>
  </form>
  <% } else { %>
  <h1>Enlace no válido</h1>
  <p>
    Este enlace expiró, ya fue utilizado o no existe. Solicita uno nuevo para
    continuar.
  </p>
  <% } %>
  <a href="/recuperar-password">Solicitar otro enlace</a>
</div>


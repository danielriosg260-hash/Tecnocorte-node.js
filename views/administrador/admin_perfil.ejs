<%# Título: Mi Perfil - Admin TecnoCorte %>

<%- include('../partials/admin-sidebar', { active: "perfil" }) %>
<main class="ml-0 md:ml-64 flex-1 min-h-screen p-8 md:p-12 pb-24 md:pb-12">
  <%- include('../partials/panel-header') %>
  <header class="mb-10">
    <p class="tc-eyebrow mb-3">Mi cuenta</p>
    <h1 class="tc-display text-4xl md:text-5xl">
      Mi <span class="tc-gold-text">perfil</span>
    </h1>
    <p class="mt-3 text-on-surface-variant">Gestiona tu información personal.</p>
  </header>

  <div class="grid md:grid-cols-2 gap-8 max-w-5xl">
    
    <div class="tc-glass rounded-xl p-8 flex flex-col items-center text-center relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-full blur-3xl -mr-16 -mt-16 pointer-events-none"></div>
      <div class="w-28 h-28 rounded-full mb-6 bg-surface-container-highest border border-outline-variant/30 flex items-center justify-center overflow-hidden">
        
        <% if (usuario.foto) { %>
        <img src="<%= usuario.foto.url %>" alt="<%= usuario.nombre %>" class="h-full w-full object-cover" />
        <% } else { %>
        <span class="material-symbols-outlined text-primary text-6xl">person</span>
        <% } %>
      </div>
      <h2 class="font-headline text-2xl font-bold tracking-tight mb-1">
        <%= usuario.nombre %> <%= usuario.apellido %>
      </h2>
      <p class="tc-eyebrow mt-1 mb-1">Administrador</p>
      <p class="text-on-surface-variant text-sm mb-6">Miembro desde <%= fmtFecha(usuario.fecha_creacion, "F Y") %></p>
      <div class="w-full space-y-3 text-left text-sm">
        <p class="flex items-center gap-3 text-on-surface-variant">
          <span class="material-symbols-outlined text-primary text-base">mail</span><%= usuario.email %>
        </p>
        <p class="flex items-center gap-3 text-on-surface-variant">
          <span class="material-symbols-outlined text-primary text-base">call</span><%= ((usuario.telefono === undefined || usuario.telefono === null || usuario.telefono === '') ? "Sin registrar" : usuario.telefono) %>
        </p>
      </div>
      <button
        type="button"
        data-profile-edit="editar"
        class="tc-btn tc-btn--gold mt-6 w-full"
      >
        <span class="material-symbols-outlined text-[18px]">edit</span>
        Editar perfil
      </button>
    </div>

    
    <div class="flex flex-col gap-6">
      
      <div id="editar" class="hidden scroll-mt-28">
        <form method="post" enctype="multipart/form-data" class="tc-form tc-form__grid">
          

          <div class="tc-field--full space-y-3">
            <p class="tc-eyebrow">Foto de perfil</p>
            <label class="tc-field tc-field--always">
              <input type="file" name="foto" accept="image/*" class="tc-field__input" />
              <span class="tc-field__label">Imagen (JPG, PNG o WEBP)</span>
            </label>
          </div>

          <label class="tc-field">
            <input required name="nombre" value="<%= usuario.nombre %>" placeholder=" " class="tc-field__input" />
            <span class="tc-field__label">Nombre</span>
          </label>

          <label class="tc-field">
            <input required name="apellido" value="<%= usuario.apellido %>" placeholder=" " class="tc-field__input" />
            <span class="tc-field__label">Apellido</span>
          </label>

          <label class="tc-field tc-field--full">
            <input type="tel" name="telefono" value="<%= usuario.telefono %>" placeholder=" " class="tc-field__input" />
            <span class="tc-field__label">Teléfono</span>
          </label>

          <div class="tc-form__actions">
            <button type="submit" class="tc-btn tc-btn--gold">
              <span class="material-symbols-outlined text-[18px]">save</span>
              Guardar cambios
            </button>
          </div>
        </form>
        <a href="/cambiar-password" class="tc-btn tc-btn--ghost mt-4 w-full">
          <span class="material-symbols-outlined text-base">lock_reset</span>Cambiar contraseña
        </a>
      </div>

      
      <div class="tc-glass rounded-xl p-8">
        <h3 class="tc-eyebrow mb-6">Notificaciones recientes</h3>
        <% if (notificaciones) { %>
        <div class="space-y-3 max-h-64 overflow-y-auto scrollbar-hide">
          <% var _lista36 = ((notificaciones || []).slice(0, 5)); if (_lista36.length) { _lista36.forEach(function (notif, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista36.length - 1 }; var _finDeLista = _lista36.length - 1; %>
          <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-container-high">
            <span class="material-symbols-outlined text-primary text-base mt-0.5">notifications</span>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-on-surface"><%= notif.mensaje %></p>
              <p class="text-[10px] text-on-surface-variant mt-1"><%= fmtFecha(notif.fecha, "d M Y H:i") %></p>
            </div>
          </div>
          <% }); } %>
        </div>
        <% } else { %>
        <p class="text-on-surface-variant text-sm text-center py-4">No tienes notificaciones.</p>
        <% } %>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/admin-mobile-nav', { active: "perfil" }) %>


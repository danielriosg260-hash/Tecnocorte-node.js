<%# Título: Recuperar contraseña -
TecnoCorte %>

<link rel="stylesheet" href="/css/publicos/recuperar_password.css" />


<div class="password-recovery">
  <span
    class="material-symbols-outlined"
    style="font-size: 3rem; color: var(--gold)"
    >lock_reset</span
  >
  <h1>Recuperar contraseña</h1>
  
  <% if (enviado) { %>
  <div class="feedback" role="status">
    Si existe una cuenta con ese correo, recibirás un enlace para cambiar la
    contraseña.
  </div>
  <p>Revisa tu bandeja de entrada y también la carpeta de spam.</p>
  <a href="/login">Volver al inicio de sesión</a>
  <% } else { %>
  <!-- Formulario para ingresar el correo y solicitar el enlace -->
  <p>
    Escribe el correo asociado a tu cuenta y te enviaremos un enlace seguro.
  </p>
  <% if (error) { %>
  <div class="feedback error" role="alert"><%= error %></div>
  <% } %>
  <form method="post">
    
    <label for="recovery-email">Correo electrónico</label>
    <input
      id="recovery-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="tu@correo.com"
    />
    <button type="submit">Enviar enlace</button>
  </form>
  <a href="/login">Volver al inicio de sesión</a>
  <% } %>
</div>


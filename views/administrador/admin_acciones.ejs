<%# Título: Historial de acciones - TecnoCorte %>

<%- include('../partials/admin-sidebar', { active: 'acciones' }) %>
<main class="ml-0 min-w-0 flex-1 p-4 pb-24 sm:p-6 md:ml-64 md:p-12 md:pb-12">
  <%- include('../partials/panel-header') %>
  <header class="mb-8 pr-12 sm:pr-16">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Seguridad</p>
    <h1 class="mt-2 font-headline text-3xl text-on-surface sm:text-4xl">Historial de acciones</h1>
    <p class="mt-2 text-sm text-on-surface-variant">Registro de cambios sensibles, usuario responsable, fecha e IP.</p>
  </header>
  <div class="table-responsive rounded-2xl bg-surface-container-low">
    <table class="tc-table min-w-[50rem] text-left text-sm">
      <thead class="border-b border-outline-variant/20 text-xs uppercase tracking-wider text-on-surface-variant">
        <tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Elemento</th><th>Detalle</th><th>IP</th></tr>
      </thead>
      <tbody>
        <% var _lista1 = (acciones || []); if (_lista1.length) { _lista1.forEach(function (registro, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista1.length - 1 }; var _finDeLista = _lista1.length - 1; %>
        <tr class="border-b border-outline-variant/10 last:border-0">
          <td><%= fmtFecha(registro.fecha, "d/m/Y H:i") %></td>
          <td><% if (registro.actor) { %><%= registro.actor.email %><% } else { %>Sistema<% } %></td>
          <td class="font-semibold text-primary"><%= registro.accion %></td>
          <td><%= registro.entidad %><% if (registro.entidad_id) { %> #<%= registro.entidad_id %><% } %></td>
          <td class="max-w-sm break-words text-on-surface-variant"><%= ((registro.detalle === undefined || registro.detalle === null || registro.detalle === '') ? "—" : registro.detalle) %></td>
          <td><%= ((registro.ip === undefined || registro.ip === null || registro.ip === '') ? "—" : registro.ip) %></td>
        </tr>
        <% }); } else { %>
        <tr><td colspan="6" class="py-12 text-center text-on-surface-variant">Todavía no hay acciones registradas.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>
<%- include('../partials/admin-mobile-nav', { active: "acciones" }) %>


<!doctype html>
<!-- Página standalone de notificaciones del usuario -->
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Notificaciones - TecnoCorte</title>
    <%- include('../partials/favicon') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Noto+Serif:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <%- include('../partials/tema') %>
    <link rel="stylesheet" href="/css/usuarios/usuario_notificaciones.css" />
  </head>

  <body
    class="min-h-screen flex flex-col pt-24 bg-background text-on-background"
  >
    <%- include('../partials/site-nav', { active: "" }) %>
    <nav class="hidden">
      <div
        class="flex justify-between items-center px-8 py-4 w-full max-w-7xl mx-auto"
      >
        <a
          class="inline-flex"
          href="/perfil"
          aria-label="TecnoCorte"
          ><%- include('../partials/logo') %></a
        >
        <div
          class="hidden md:flex gap-8 items-center font-display uppercase tracking-widest text-sm"
        >
          <a
            class="text-on-surface-variant hover:text-primary transition-all duration-300"
            href="/perfil"
            >Inicio</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-all duration-300"
            href="/servicios"
            >Servicios</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-all duration-300"
            href="/tienda"
            >Tienda</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-all duration-300"
            href="/peluquerias"
            >Peluquerías</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-all duration-300"
            href="/ayuda"
            >Contactos</a
          >
        </div>
        <div class="flex items-center gap-5">
          <button
            data-theme-toggle
            onclick="toggleTheme()"
            class="text-primary transition-all duration-300 hover:text-primary-container active:scale-90"
            title="Activar tema claro"
            type="button"
          >
            <span class="material-symbols-outlined theme-icon">light_mode</span>
          </button>
          <a
            href="/carrito"
            class="relative text-primary hover:text-primary-container transition-all duration-300"
            title="Carrito"
          >
            <span class="material-symbols-outlined">shopping_cart</span>
            <span
              class="absolute -top-2 -right-2 min-w-5 h-5 px-1 rounded-full bg-primary text-on-primary text-[10px] font-bold flex items-center justify-center"
              ><%= ((cantidad === undefined || cantidad === null || cantidad === '') ? "0" : cantidad) %></span
            >
          </a>
          <a
            href="/perfil"
            class="text-primary hover:text-primary-container transition-colors"
            title="Perfil"
          >
            <span
              class="material-symbols-outlined"
              style="font-variation-settings: &quot;FILL&quot; 1"
              >account_circle</span
            >
          </a>
          <a
            href="/logout"
            class="text-on-surface-variant hover:text-error transition-colors text-xs font-bold uppercase tracking-widest"
            >Salir</a
          >
        </div>
      </div>
    </nav>

    <main class="flex-grow w-full max-w-4xl mx-auto px-6 pt-32 pb-12 md:pb-16">
      <div
        class="flex flex-col gap-5 justify-between items-start mb-8 border-b border-outline-variant/10 pb-4 sm:flex-row sm:items-end"
      >
        <div>
          <a
            href="/perfil"
            class="flex items-center gap-1 text-primary text-xs uppercase tracking-widest hover:text-primary-container transition-colors mb-4 active:scale-95"
          >
            <span class="material-symbols-outlined text-sm">arrow_back</span
            >Volver al perfil
          </a>
          <h1 class="font-headline text-4xl tracking-tight">Notificaciones</h1>
        </div>
        
      <% if (notificaciones_no_leidas) { %>
        <form
          method="post"
          action="/notificaciones/leidas"
        >
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-md border border-outline-variant/30 px-4 py-2 text-xs font-bold uppercase tracking-widest text-primary transition-colors hover:border-primary"
          >
            <span class="material-symbols-outlined text-base">done_all</span
            >Marcar como leídas
          </button>
        </form>
        <% } %>
      </div>

      
      <div class="space-y-4">
        
        <% var _lista77 = (notificaciones || []); if (_lista77.length) { _lista77.forEach(function (notificacion, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista77.length - 1 }; var _finDeLista = _lista77.length - 1; %>
        <article
          class="bg-surface-container-low rounded-xl p-6 ambient-glow flex gap-4 <% if (notificacion.leida) { %>opacity-75<% } else { %>border-l-2 border-primary<% } %>"
        >
          <div
            class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0"
          >
            <span class="material-symbols-outlined text-primary text-lg"
              ><% if (notificacion.leida) { %>notifications_off<% } else { %>notifications<% } %></span
            >
          </div>
          <div class="flex-1">
            <p class="font-body text-on-surface"><%= notificacion.mensaje %></p>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mt-3">
              <p class="text-on-surface-variant text-xs">
                <%= fmtFecha(notificacion.fecha, "d/m/Y H:i") %>
              </p>
              <% if (notificacion.reserva && notificacion.reserva.estado == 'Pendiente') { %><% if (((notificacion.mensaje) || []).includes('suspendido')) { %><a
                href="<%= `/editar-reserva/${notificacion.reserva.id}` %>"
                class="inline-flex items-center gap-1 rounded-md bg-primary px-3 py-2 text-[10px] font-bold uppercase tracking-widest text-on-primary transition-opacity hover:opacity-90"
                ><span class="material-symbols-outlined text-sm"
                  >edit_calendar</span
                >Modificar cita</a
              ><% } else if (((notificacion.mensaje) || []).includes('Confírmala')) { %>
              <form
                method="post"
                action="<%= `/confirmar-cita/${notificacion.reserva.id}` %>"
              >
                <button
                  type="submit"
                  class="inline-flex items-center gap-1 rounded-md bg-primary px-3 py-2 text-[10px] font-bold uppercase tracking-widest text-on-primary transition-opacity hover:opacity-90"
                >
                  <span class="material-symbols-outlined text-sm"
                    >event_available</span
                  >Confirmar cita
                </button>
              </form>
              <% } %><% } %> <% if (notificacion.reserva && notificacion.reserva.estado == 'Completada' && !((calificaciones_reservas) || []).includes(notificacion.reserva.id) && resenas_restantes) { %>
              <a
                href="/perfil#citas"
                class="gold-gradient inline-flex text-on-primary font-bold py-1 px-4 rounded-md text-[10px] uppercase tracking-widest hover:opacity-90 transition-opacity active:scale-95"
                >Calificar servicio</a
              >
              <% } %>
            </div>
          </div>
        </article>
        <% }); } else { %>
        <div
          class="text-center py-16 bg-surface-container-low rounded-xl ghost-border"
        >
          <span
            class="material-symbols-outlined text-primary/40 text-5xl mb-4 block"
            >notifications_off</span
          >
          <p class="text-on-surface-variant mb-6">
            No tienes notificaciones nuevas.
          </p>
          <a
            href="/reservar-cita"
            class="inline-flex justify-center py-3 px-8 rounded-md gold-gradient text-on-primary font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all active:scale-95"
            >Reservar una cita</a
          >
        </div>
        <% } %>
      </div>
    </main>
  </body>
</html>


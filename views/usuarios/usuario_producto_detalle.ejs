<%# Título: - TecnoCorte %>
<link rel="stylesheet" href="/css/usuarios/usuario_tienda.css" />

<main class="tc-product-detail mx-auto w-full max-w-5xl px-4 pt-32 pb-10 md:px-8">
  <a href="/tienda" class="mb-8 inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-primary">
    <span class="material-symbols-outlined">arrow_back</span> Volver a la tienda
  </a>
  <section class="grid items-center gap-10 rounded-[28px] border border-outline-variant/30 bg-surface-container-low p-6 md:grid-cols-2 md:p-10">
    <div class="flex min-h-[320px] items-center justify-center overflow-hidden rounded-2xl bg-surface-container-highest p-6">
      <% if (producto.imagen) { %><img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" class="h-full max-h-[360px] w-full object-contain" /><% } else { %><img src="/images/Logo.webp" alt="<%= producto.nombre %>" class="h-full max-h-[260px] w-full object-contain" /><% } %>
    </div>
    <div>
      <p class="tc-eyebrow"><%= producto.categoria_display %></p>
      <h1 class="mt-3 font-headline text-4xl text-on-surface"><%= producto.nombre %></h1>
      <p class="mt-4 text-on-surface-variant"><%= ((producto.descripcion === undefined || producto.descripcion === null || producto.descripcion === '') ? "Producto seleccionado para tu rutina de cuidado personal." : producto.descripcion) %></p>
      <p class="mt-8 font-headline text-3xl text-primary">$<%= Number(Number(producto.precio) || 0).toFixed(1) %> <span class="text-sm text-on-surface-variant">COP</span></p>
      <% if (producto.disponible && producto.stock > 0) { %>
      <form method="post" action="<%= `/carrito/agregar/${producto.id}` %>" class="add-to-cart-form mt-8" data-nombre="<%= producto.nombre %>"><button class="tc-btn tc-btn--gold" type="submit"><span class="material-symbols-outlined">shopping_bag</span> Añadir al carrito</button></form>
      <% } else { %><p class="mt-8 font-bold text-error">Producto no disponible</p><% } %>
    </div>
  </section>
</main>
<%- include('../partials/agregar-carrito-ajax') %>


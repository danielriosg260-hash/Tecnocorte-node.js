<%# Título: EditarCrear Usuario - TecnoCorte %>

<%- include('../partials/admin-sidebar', { active: "usuarios" }) %>
<main class="ml-0 md:ml-64 flex-1 min-h-screen p-6 md:p-12 pb-24 md:pb-12 bg-surface">
  <%- include('../partials/panel-header') %>
  <div class="mx-auto max-w-3xl">
    <div class="mb-8">
      <p class="tc-eyebrow mb-3">Personas</p>
      <h1 class="tc-display text-4xl md:text-5xl">
        <% if (editar) { %>Editar<% } else { %>Crear<% } %>
        <span class="tc-gold-text">usuario</span>
      </h1>
      <p class="mt-3 text-on-surface-variant">
        <% if (editar) { %>
          Modifica los datos del usuario.
        <% } else { %>
          Crea un nuevo usuario en el sistema.
        <% } %>
      </p>
    </div>

    <form method="POST" enctype="multipart/form-data" class="tc-form tc-form__grid">
      
      <% if (error) { %>
      <div
        class="tc-field--full rounded-xl border border-error/40 bg-error/10 p-3 text-sm text-error"
      >
        <%= error %>
      </div>
      <% } %>

      <label class="tc-field">
        <input
          required
          type="text"
          id="nombre"
          name="nombre"
          value="<%= ((usuario.nombre === undefined || usuario.nombre === null || usuario.nombre === '') ? "" : usuario.nombre) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Nombre</span>
      </label>

      <label class="tc-field">
        <input
          required
          type="text"
          id="apellido"
          name="apellido"
          value="<%= ((usuario.apellido === undefined || usuario.apellido === null || usuario.apellido === '') ? "" : usuario.apellido) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Apellido</span>
      </label>

      <label class="tc-field tc-field--full">
        <input
          required
          type="email"
          id="email"
          name="email"
          value="<%= ((usuario.email === undefined || usuario.email === null || usuario.email === '') ? "" : usuario.email) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Correo electrónico</span>
      </label>

      <label class="tc-field tc-field--full">
        <input
          type="tel"
          id="telefono"
          name="telefono"
          value="<%= ((usuario.telefono === undefined || usuario.telefono === null || usuario.telefono === '') ? "" : usuario.telefono) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Teléfono</span>
      </label>

      
      <div class="tc-field--full space-y-3">
        <p class="tc-eyebrow">Foto de perfil</p>
        <% if (usuario.foto) { %>
        <img
          src="<%= usuario.foto.url %>"
          alt="<%= usuario.nombre %>"
          class="h-24 w-24 rounded-full border border-primary/25 object-cover"
        />
        <label class="tc-switch">
          <input type="checkbox" name="quitar_foto" />
          <span class="text-error">Quitar la foto actual</span>
        </label>
        <% } %>
        <label class="tc-field tc-field--always">
          <input type="file" id="foto" name="foto" accept="image/*" class="tc-field__input" />
          <span class="tc-field__label">Imagen (JPG, PNG o WEBP)</span>
        </label>
      </div>

      <label class="tc-field tc-field--always tc-field--full">
        <select id="rol" name="rol" onchange="togglePeluqueriaField()" required class="tc-field__input">
          
          <option value="">-- Selecciona un rol --</option>
          <% var _lista17 = (roles || []); if (_lista17.length) { _lista17.forEach(function ([value, label], indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista17.length - 1 }; var _finDeLista = _lista17.length - 1; %>
          <option value="<%= value %>" <% if (usuario.rol == value) { %>selected<% } %>>
            <%= label %>
          </option>
          <% }); } %>
        </select>
        <span class="tc-field__label">Rol</span>
      </label>

      
      <div id="campo-peluqueria" class="tc-field--full" style="display: none">
        <label class="tc-field tc-field--always">
          <select id="peluqueria" name="peluqueria" class="tc-field__input">
            <option value="">-- Selecciona una barbería --</option>
            <% var _lista18 = (peluquerias || []); if (_lista18.length) { _lista18.forEach(function (peluqueria, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista18.length - 1 }; var _finDeLista = _lista18.length - 1; %>
            <option
              value="<%= peluqueria.id %>"
              <% if (usuario.peluqueria_id == peluqueria.id) { %>selected<% } %>
            >
              <%= peluqueria.nombre %>
            </option>
            <% }); } %>
          </select>
          <span class="tc-field__label">Barbería</span>
        </label>
      </div>

      <label class="tc-field tc-field--full">
        <input
          type="password"
          id="password"
          name="password"
          placeholder=" "
          <% if (!(editar)) { %>required<% } %>
          class="tc-field__input"
        />
        <span class="tc-field__label">Contraseña</span>
      </label>
      <span class="tc-field__hint tc-field--full">
        <% if (editar) { %>
          Déjala vacía para conservar la contraseña actual.
        <% } else { %>
          Mínimo 8 caracteres, con mayúscula, minúscula y número.
        <% } %>
      </span>

      <div class="tc-form__actions">
        <button class="tc-btn tc-btn--gold" type="submit">
          <span class="material-symbols-outlined text-[18px]">save</span>
          <% if (editar) { %>Actualizar usuario<% } else { %>Crear usuario<% } %>
        </button>
        <a href="/admin/usuarios" class="tc-btn tc-btn--ghost"
          >Cancelar</a
        >
      </div>
    </form>

    <% if (editar) { %>
    
    <div class="mt-8 flex flex-wrap gap-6 border-t border-outline-variant/15 pt-6 text-sm text-on-surface-variant">
      <p><strong class="text-on-surface">ID de usuario:</strong> <%= usuario.id %></p>
      <p><strong class="text-on-surface">Creado:</strong> <%= fmtFecha(usuario.fecha_creacion, "d/m/Y H:i") %></p>
    </div>
    <% } %>
  </div>
</main>
<%- include('../partials/admin-mobile-nav', { active: "usuarios" }) %>
<script>
  function togglePeluqueriaField() {
    var rol = document.getElementById("rol");
    var campo = document.getElementById("campo-peluqueria");
    if (!rol || !campo) return;
    var esBarbero = rol.value === "Barbero";
    campo.style.display = esBarbero ? "block" : "none";
    // La barbería es obligatoria cuando el rol es Barbero.
    var select = campo.querySelector("select[name='peluqueria']");
    if (select) select.required = esBarbero;
  }
  document.addEventListener("DOMContentLoaded", togglePeluqueriaField);
</script>


# Datos de conexión con MongoDB Atlas (en Vercel usa una URI mongodb+srv)
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/tecnocorte?retryWrites=true&w=majority
MONGO_DB_NAME=tecnocorte

# Sesión de los usuarios
JWT_SECRET=cambia_esta_clave_por_una_clave_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRE=7d

# Servidor
# PORT lo asigna Vercel; solo es necesario para ejecutar localmente.
PORT=3000
NODE_ENV=production
TZ=America/Bogota
APP_URL=https://TU-PROYECTO.vercel.app

# Correo que envía las notificaciones (Gmail con contraseña de aplicación)
EMAIL_USER=tecnocorte083@gmail.com
EMAIL_PASS=

# Vercel Blob (Vercel la puede inyectar automáticamente al conectar un Blob Store)
BLOB_READ_WRITE_TOKEN=

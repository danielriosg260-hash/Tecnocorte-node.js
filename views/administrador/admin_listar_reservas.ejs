<%# Título: Gestión de Reservas - TecnoCorte %>

<%- include('../partials/admin-sidebar', { active: "reservas" }) %>

<main class="ml-0 md:ml-64 flex-1 min-h-screen p-6 md:p-12 pb-24 md:pb-12 bg-surface">
  <%- include('../partials/panel-header') %>
  <!-- Header Section -->
  <header class="flex flex-wrap justify-between items-end gap-4 mb-8 md:mb-16">
    <div>
      <h2 class="font-headline text-3xl md:text-4xl text-on-background tracking-tight">
        Gestión de Reservas
      </h2>
      <p class="font-body text-base text-on-surface-variant mt-2">
        <%= new Date().getFullYear() %>
      </p>
    </div>
    <!-- Actions & Search -->
    <div class="flex items-center w-full md:w-auto">
      <!-- Search Input -->
      <div class="relative group w-full md:w-64">
        <input
          id="search-reserva"
          class="w-full bg-transparent border-b border-outline-variant/20 focus:border-primary text-on-background font-body text-sm py-2 pl-8 pr-4 transition-colors focus:ring-0 placeholder:text-on-surface-variant/50"
          placeholder="Buscar por nombre o fecha..."
          type="text"
          aria-label="Buscar reservas"
        />
        <span
          class="material-symbols-outlined absolute left-0 top-2.5 text-on-surface-variant/50 text-sm group-focus-within:text-primary transition-colors"
          >search</span
        >
      </div>
      <form method="get" class="flex w-full flex-wrap items-center gap-2 md:w-auto">
        <label class="sr-only" for="filtro-fecha">Filtrar por fecha</label>
        <input id="filtro-fecha" name="fecha" type="date" value="<%= filtro_fecha %>" class="rounded-lg border border-outline-variant/30 bg-surface-container-low px-3 py-2 text-sm text-on-surface" />
        <label class="sr-only" for="filtro-estado">Filtrar por estado</label>
        <select id="filtro-estado" name="estado" class="rounded-lg border border-outline-variant/30 bg-surface-container-low px-3 py-2 text-sm text-on-surface">
          <option value="">Todos los estados</option>
          <% var _lista26 = (reserva_estados || []); if (_lista26.length) { _lista26.forEach(function ([opcion, etiqueta], indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista26.length - 1 }; var _finDeLista = _lista26.length - 1; %><option value="<%= opcion %>" <% if (filtro_estado == opcion) { %>selected<% } %>><%= etiqueta %></option><% }); } %>
        </select>
        <button type="submit" class="tc-btn tc-btn--gold tc-btn--sm">Filtrar</button>
      </form>
    </div>
  </header>
  <!-- Status Overview Chips -->
  
  <div class="flex flex-wrap gap-2 md:gap-4 mb-8 md:mb-12">
    <button
      class="chip-reserva bg-primary text-on-primary px-6 py-2 rounded-full font-label text-xs uppercase tracking-widest font-bold"
      data-filtro="todas"
    >
      Todas (<%= (datos || []).length %>)
    </button>
    <button
      class="chip-reserva bg-surface-container-highest text-on-surface-variant px-6 py-2 rounded-full font-label text-xs uppercase tracking-widest hover:bg-surface-container-high transition-colors"
      data-filtro="pendiente"
    >
      Pendientes (<% var _lista27 = (estado_list || []); if (_lista27.length) { _lista27.forEach(function (status, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista27.length - 1 }; var _finDeLista = _lista27.length - 1; %><% if (status.grouper == 'Pendiente') { %><%= (status.list || []).length %><% } %><% }); } %>)
    </button>
    <button
      class="chip-reserva bg-surface-container-highest text-on-surface-variant px-6 py-2 rounded-full font-label text-xs uppercase tracking-widest hover:bg-surface-container-high transition-colors"
      data-filtro="confirmada"
    >
      Confirmadas (<% var _lista28 = (estado_list || []); if (_lista28.length) { _lista28.forEach(function (status, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista28.length - 1 }; var _finDeLista = _lista28.length - 1; %><% if (status.grouper == 'Confirmada') { %><%= (status.list || []).length %><% } %><% }); } %>)
    </button>
  </div>
  <!-- Data Table / List -->
  <div
    class="bg-surface-container-low rounded-lg ambient-shadow overflow-hidden"
  >
    <div class="table-responsive">
    <div class="min-w-[760px]">
    <!-- Table Header -->
    <div
      class="grid grid-cols-6 gap-6 px-8 py-6 border-b border-surface-container-highest bg-surface-container-high/50"
    >
      <div
        class="font-label text-xs uppercase tracking-widest text-on-surface-variant"
      >
        Hora
      </div>
      <div
        class="font-label text-xs uppercase tracking-widest text-on-surface-variant col-span-2"
      >
        Cliente
      </div>
      <div
        class="font-label text-xs uppercase tracking-widest text-on-surface-variant"
      >
        Servicio
      </div>
      <div
        class="font-label text-xs uppercase tracking-widest text-on-surface-variant"
      >
        Estado
      </div>
      <div
        class="font-label text-xs uppercase tracking-widest text-on-surface-variant text-right"
      >
        Acciones
      </div>
    </div>
    <!-- List Items -->
    
    <div class="divide-y divide-surface-container-highest">
      <% var _lista29 = (datos || []); if (_lista29.length) { _lista29.forEach(function (reserva, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista29.length - 1 }; var _finDeLista = _lista29.length - 1; %>
      <div
        class="grid grid-cols-6 gap-6 px-8 py-6 items-center hover:bg-surface-container-highest/30 transition-colors fila-reserva"
         data-estado="<%= reserva.estado %>"
         data-fecha="<%= fmtFecha(reserva.fecha, "Y-m-d") %>"
      >
        <div class="font-headline text-xl text-primary"><%= reserva.hora %></div>
        <div class="col-span-2">
          <p class="font-body text-base text-on-background font-medium">
            <%= reserva.cliente.nombre %>
          </p>
          <p class="font-body text-sm text-on-surface-variant">
            Barbero: <%= reserva.peluquero.nombre %>
          </p>
        </div>
        <div class="font-body text-sm text-on-surface-variant">
          <%= reserva.servicio %>
        </div>
        <div>
          <span
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-label uppercase tracking-widest <% if (reserva.estado == 'Confirmada') { %>bg-primary/10 text-primary border border-primary/20<% } else { %>bg-secondary-container/20 text-secondary border border-secondary-container/30<% } %>"
          >
            <%= reserva.estado %>
          </span>
        </div>
        <div class="flex justify-end space-x-3">
          <a
            class="text-primary hover:text-primary-container transition-colors p-2"
            href="<%= `/admin/reservas/${reserva.id}/editar` %>"
            title="Reasignar"
          >
            <span class="material-symbols-outlined">edit_calendar</span>
          </a>
          <form
            method="post"
            action="<%= `/admin/reservas/${reserva.id}/cancelar` %>"
            class="inline"
          >
            
            <button
              class="text-error hover:text-error-container transition-colors p-2"
              data-confirm="¿Cancelar esta reserva?"
              title="Cancelar"
              type="submit"
            >
              <span class="material-symbols-outlined">cancel</span>
            </button>
          </form>
        </div>
      </div>
      <% }); } else { %>
      <div class="px-8 py-12 text-center text-on-surface-variant">
        <p class="font-body">No hay reservas disponibles</p>
      </div>
      <% } %>
    </div>
    </div>
    </div>
  </div>
  <div class="signature-divider mt-12"></div>
</main>
<script>
  (function () {
    var filtroActivo = "todas";
    var filas = document.querySelectorAll(".fila-reserva");
    var chips = document.querySelectorAll(".chip-reserva");
    var search = document.getElementById("search-reserva");

    function aplicarFiltro() {
      var q = (search ? search.value : "").toLowerCase();
      var visibles = 0;
      filas.forEach(function (fila) {
        var estado = (fila.getAttribute("data-estado") || "").toLowerCase();
        var coincideEstado =
          filtroActivo === "todas" || estado.indexOf(filtroActivo) === 0;
        var coincideTexto = fila.textContent.toLowerCase().indexOf(q) !== -1;
        var mostrar = coincideEstado && coincideTexto;
        fila.style.display = mostrar ? "" : "none";
        if (mostrar) visibles++;
      });
    }

    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        filtroActivo = chip.getAttribute("data-filtro");
        chips.forEach(function (c) {
          c.classList.remove("bg-primary", "text-on-primary", "font-bold");
          c.classList.add(
            "bg-surface-container-highest",
            "text-on-surface-variant",
          );
        });
        chip.classList.add("bg-primary", "text-on-primary", "font-bold");
        chip.classList.remove(
          "bg-surface-container-highest",
          "text-on-surface-variant",
        );
        aplicarFiltro();
      });
    });

    if (search) search.addEventListener("input", aplicarFiltro);
    aplicarFiltro();
  })();
</script>
<%- include('../partials/admin-mobile-nav', { active: "reservas" }) %>


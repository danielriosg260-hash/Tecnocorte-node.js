<%- include('../partials/admin-sidebar', { active: "servicios" }) %>
<main class="ml-0 md:ml-64 flex-1 p-6 md:p-12 pb-24 md:pb-12">
  <%- include('../partials/panel-header') %>

  <div class="mb-10 border-b border-surface-container-low pb-6">
    <p class="tc-eyebrow mb-3">Barberos</p>
    <h1 class="tc-display text-3xl md:text-4xl">
      Solicitudes de <span class="tc-gold-text">servicios</span>
    </h1>
    <p class="mt-3 max-w-2xl text-sm text-on-surface-variant">
      Los barberos piden servicios nuevos. Al aprobar una solicitud se crea el
      servicio a nombre de ese barbero y queda disponible en el catálogo de
      reservas.
    </p>
  </div>

  
  <h2 class="tc-eyebrow mb-4">Pendientes (<%= (pendientes || []).length %>)</h2>
  <div class="mb-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <% var _lista38 = (pendientes || []); if (_lista38.length) { _lista38.forEach(function (s, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista38.length - 1 }; var _finDeLista = _lista38.length - 1; %>
    <article class="tc-glass rounded-2xl p-6">
      <div class="mb-4 flex items-start justify-between gap-4">
        <div>
          <h3 class="font-headline text-xl text-on-surface"><%= s.nombre %></h3>
          <p class="text-xs text-on-surface-variant">
            Pide:
            <span class="text-primary"
              ><%= s.barbero.nombre %> <%= s.barbero.apellido %></span
            >
            <% if (s.barbero.peluqueria_id) { %>
            · <%= s.barbero.peluqueria_id.nombre %>
            <% } %>
          </p>
        </div>
        <span
          class="inline-flex shrink-0 items-center gap-1 rounded-full bg-primary/15 px-3 py-1 text-xs font-semibold text-primary"
        >
          <span class="material-symbols-outlined text-sm">hourglass_top</span>
          Pendiente
        </span>
      </div>

      <div class="mb-4 flex flex-wrap gap-4 text-sm text-on-surface-variant">
        <span class="flex items-center gap-1"
          ><span class="material-symbols-outlined text-base">schedule</span
          ><%= s.duracion %></span
        >
        <span class="flex items-center gap-1"
          ><span class="material-symbols-outlined text-base">payments</span
          >$<%= Number(Number(s.precio) || 0).toFixed(1) %> COP</span
        >
        <span class="flex items-center gap-1"
          ><span class="material-symbols-outlined text-base">event</span
          ><%= fmtFecha(s.creada, "d/m/Y H:i") %></span
        >
      </div>

      <% if (s.descripcion) { %>
      <p class="mb-4 rounded-xl border border-outline-variant/15 p-4 text-sm text-on-surface-variant">
        <%= s.descripcion %>
      </p>
      <% } %>

      <form method="post" class="space-y-4">
        
        <input type="hidden" name="solicitud_id" value="<%= s.id %>" />
        <label class="tc-field tc-field--always">
          <input
            name="nota_admin"
            maxlength="300"
            placeholder=" "
            class="tc-field__input"
          />
          <span class="tc-field__label">Nota para el barbero (opcional)</span>
        </label>
        <div class="flex flex-wrap gap-3">
          <button
            class="tc-btn tc-btn--gold"
            type="submit"
            name="accion"
            value="aprobar"
          >
            <span class="material-symbols-outlined text-[18px]"
              >check_circle</span
            >
            Aprobar y crear
          </button>
          <button
            class="tc-btn tc-btn--ghost"
            type="submit"
            name="accion"
            value="rechazar"
          >
            <span class="material-symbols-outlined text-[18px]">cancel</span>
            Rechazar
          </button>
        </div>
      </form>
    </article>
    <% }); } else { %>
    <div class="tc-glass rounded-2xl p-6 text-sm text-on-surface-variant">
      No hay solicitudes pendientes. Todo al día.
    </div>
    <% } %>
  </div>

  
  <div class="tc-stack">
    
    <section>
      <h2 class="tc-eyebrow mb-4">Servicios propios ya creados</h2>
      <div class="tc-glass overflow-hidden rounded-2xl border border-outline-variant/20">
        <div class="table-responsive">
          <table class="w-full text-left text-sm">
            <thead>
              <tr
                class="border-b border-outline-variant/30 text-xs uppercase tracking-wider text-on-surface-variant"
              >
                <th class="px-5 py-4 font-semibold">Servicio</th>
                <th class="px-5 py-4 font-semibold">Barbero</th>
                <th class="px-5 py-4 font-semibold">Barbería</th>
                <th class="px-5 py-4 font-semibold">Duración</th>
                <th class="px-5 py-4 text-right font-semibold">Precio</th>
              </tr>
            </thead>
            <tbody>
              <% var _lista39 = (servicios_barberos || []); if (_lista39.length) { _lista39.forEach(function (s, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista39.length - 1 }; var _finDeLista = _lista39.length - 1; %>
              <tr class="border-b border-outline-variant/10 last:border-0">
                <td class="px-5 py-4 font-medium text-on-surface"><%= s.nombre %></td>
                <td class="px-5 py-4 text-on-surface-variant">
                  <%= s.barbero.nombre %> <%= s.barbero.apellido %>
                </td>
                <td class="px-5 py-4 text-on-surface-variant">
                  <%= (s.peluqueria ? s.peluqueria.nombre : '—') %>
                </td>
                <td class="px-5 py-4 text-on-surface-variant"><%= s.duracion %></td>
                <td class="px-5 py-4 text-right font-headline text-primary">
                  $<%= Number(Number(s.precio) || 0).toFixed(1) %> COP
                </td>
              </tr>
              <% }); } else { %>
              <tr>
                <td colspan="5" class="px-5 py-10 text-center text-on-surface-variant">
                  Todavía no se ha creado ningún servicio propio.
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    
    <section>
      <h2 class="tc-eyebrow mb-4">Historial</h2>
      <div class="tc-glass overflow-hidden rounded-2xl border border-outline-variant/20">
        <div class="table-responsive">
          <table class="w-full text-left text-sm">
            <thead>
              <tr
                class="border-b border-outline-variant/30 text-xs uppercase tracking-wider text-on-surface-variant"
              >
                <th class="px-5 py-4 font-semibold">Servicio</th>
                <th class="px-5 py-4 font-semibold">Barbero</th>
                <th class="px-5 py-4 font-semibold">Estado</th>
                <th class="px-5 py-4 font-semibold">Nota</th>
                <th class="px-5 py-4 text-right font-semibold">Resuelta</th>
              </tr>
            </thead>
            <tbody>
              <% var _lista40 = (resueltas || []); if (_lista40.length) { _lista40.forEach(function (s, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista40.length - 1 }; var _finDeLista = _lista40.length - 1; %>
              <tr class="border-b border-outline-variant/10 last:border-0">
                <td class="px-5 py-4 font-medium text-on-surface"><%= s.nombre %></td>
                <td class="px-5 py-4 text-on-surface-variant">
                  <%= s.barbero.nombre %> <%= s.barbero.apellido %>
                </td>
                <td class="px-5 py-4">
                  <% if (s.estado == "aprobada") { %>
                  <span class="tc-badge tc-badge--ok">
                    <span class="material-symbols-outlined text-sm">check_circle</span>Aprobada
                  </span>
                  <% } else { %>
                  <span class="tc-badge tc-badge--no">
                    <span class="material-symbols-outlined text-sm">cancel</span>Rechazada
                  </span>
                  <% } %>
                </td>
                <td class="px-5 py-4 text-xs text-on-surface-variant">
                  <%= ((s.nota_admin === undefined || s.nota_admin === null || s.nota_admin === '') ? "—" : s.nota_admin) %>
                </td>
                <td class="px-5 py-4 text-right text-xs text-on-surface-variant">
                  <%= ((fmtFecha(s.resuelta, "d/m/Y H:i") === undefined || fmtFecha(s.resuelta, "d/m/Y H:i") === null || fmtFecha(s.resuelta, "d/m/Y H:i") === '') ? "—" : fmtFecha(s.resuelta, "d/m/Y H:i")) %>
                </td>
              </tr>
              <% }); } else { %>
              <tr>
                <td colspan="5" class="px-5 py-10 text-center text-on-surface-variant">
                  Sin historial todavía.
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</main>
<%- include('../partials/admin-mobile-nav', { active: "servicios" }) %>


<!-- Barra lateral del barbero: identidad, navegación y nueva cita -->
<%
  var activo = typeof active !== 'undefined' ? active : '';
  var clases = function (nombre) {
    return 'panel-glass-link flex items-center gap-4 p-3 ' + (activo === nombre ? 'panel-glass-link--active' : 'text-on-surface-variant font-medium');
  };
  var pendientes = typeof notificaciones_no_leidas !== 'undefined' ? notificaciones_no_leidas : 0;
%>
<nav class="peluquero-sidebar panel-glass hidden md:flex flex-col fixed left-0 top-0 h-screen w-72 p-6 z-50">
  <div class="tc-panel-brand mb-8 flex items-center gap-3 border-b border-primary/10 pb-5">
    <%- include('logo', { logo_class: 'h-12 w-12' }) %>
    <div class="min-w-0">
      <p class="font-headline text-lg font-bold leading-tight text-primary-container">TecnoCorte</p>
      <p class="truncate font-label text-[0.6rem] uppercase tracking-[0.16em] text-on-surface-variant">Panel de barbero</p>
    </div>
  </div>

  <div class="mb-10 flex items-center gap-4">
    <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-primary-container bg-surface-container-high flex items-center justify-center">
      <span class="material-symbols-outlined text-primary">person</span>
    </div>
    <div>
      <h2 class="font-headline text-xl font-bold text-primary-container"><%= logueado ? logueado.nombre : '' %></h2>
      <p class="font-label uppercase tracking-widest text-[0.65rem] text-on-surface-variant mt-1">Barbero</p>
    </div>
  </div>

  <div class="flex-1 space-y-2">
    <a class="<%= clases('inicio') %>" href="/barbero">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 1">dashboard</span>
      <span class="font-label uppercase tracking-widest text-sm">Inicio</span>
    </a>
    <a class="<%= clases('peluqueria') %>" href="/barbero/peluqueria">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 1">storefront</span>
      <span class="font-label uppercase tracking-widest text-sm">Mi Peluquería</span>
    </a>
    <a class="<%= clases('galeria') %>" href="/barbero/galeria">
      <span class="material-symbols-outlined">photo_library</span>
      <span class="font-label uppercase tracking-widest text-sm">Galería</span>
    </a>
    <a class="<%= clases('configuracion') %>" href="/barbero/configuracion">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 1">settings</span>
      <span class="font-label uppercase tracking-widest text-sm">Configuración</span>
    </a>
    <a class="<%= clases('notificaciones') %>" href="/barbero/notificaciones">
      <span class="material-symbols-outlined">notifications</span>
      <span class="font-label uppercase tracking-widest text-sm">Notificaciones</span>
      <% if (pendientes) { %>
      <span class="ml-auto flex h-5 min-w-5 items-center justify-center rounded-full bg-error px-1 text-[10px] font-bold text-on-error"><%= pendientes %></span>
      <% } %>
    </a>
  </div>

  <a href="/barbero/nueva-cita" class="panel-glass-cta w-full font-label uppercase tracking-widest text-sm font-bold py-4 rounded-xl mb-8 flex items-center justify-center gap-2 active:scale-95">
    <span class="material-symbols-outlined text-base">add</span>Nueva Cita
  </a>
</nav>

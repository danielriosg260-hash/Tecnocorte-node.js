<%# Título: Nueva Cita -
TecnoCorte %>
 <%- include('../partials/peluquero-sidebar', { active: "nueva_cita" }) %>
<main class="flex-1 md:ml-72 flex flex-col min-h-screen relative bg-background">
  <%- include('../partials/panel-header') %>
  <div class="px-6 md:px-12 pt-6">
    <a
      href="/barbero"
      class="inline-flex items-center gap-2 text-primary uppercase tracking-widest text-sm font-bold hover:text-primary-container transition-colors active:scale-95"
    >
      <span class="material-symbols-outlined text-base">arrow_back</span>Volver
    </a>
  </div>
  <div class="p-6 md:p-12 max-w-3xl mx-auto w-full">
    <p class="tc-eyebrow mb-3">Agenda</p>
    <h2 class="tc-display text-4xl md:text-5xl tracking-tight mb-2">
      Nueva <span class="tc-gold-text">Cita</span>
    </h2>
    <p class="font-body text-on-surface-variant mb-10">
      Agenda una cita para uno de tus clientes.
    </p>
    <% if (error) { %>
    <p
      class="mb-6 rounded-xl border border-error/50 bg-error-container/20 px-4 py-3 text-error"
    >
      <%= error %>
    </p>
    <% } %>

    
    <form method="post" class="tc-form tc-form__grid">
      

      <label class="tc-field tc-field--always">
        <select name="cliente" required class="tc-field__input">
          <option value="">Seleccione un cliente</option>
          <% var _lista52 = (clientes || []); if (_lista52.length) { _lista52.forEach(function (cliente, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista52.length - 1 }; var _finDeLista = _lista52.length - 1; %>
          <option value="<%= cliente.id %>">
            <%= cliente.nombre %> <%= cliente.apellido %>
          </option>
          <% }); } %>
        </select>
        <span class="tc-field__label">Cliente</span>
      </label>

      <label class="tc-field tc-field--always">
        <select name="peluqueria" required class="tc-field__input">
          <option value="">Seleccione una peluquería</option>
          <% var _lista53 = (peluquerias || []); if (_lista53.length) { _lista53.forEach(function (peluqueria, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista53.length - 1 }; var _finDeLista = _lista53.length - 1; %>
          <option value="<%= peluqueria.id %>"><%= peluqueria.nombre %></option>
          <% }); } %>
        </select>
        <span class="tc-field__label">Peluquería</span>
      </label>

      <label class="tc-field tc-field--always tc-field--full">
        <select name="servicio" class="tc-field__input">
          <% var _lista54 = (servicios || []); if (_lista54.length) { _lista54.forEach(function (servicio, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista54.length - 1 }; var _finDeLista = _lista54.length - 1; %>
          <option value="<%= servicio.nombre %>">
            <%= servicio.nombre %> — $<%= servicio.precio %>
          </option>
          <% }); } %>
        </select>
        <span class="tc-field__label">Servicio</span>
      </label>

      <label class="tc-field tc-field--always">
        <input type="date" name="fecha" required class="tc-field__input" />
        <span class="tc-field__label">Fecha</span>
      </label>

      <label class="tc-field tc-field--always">
        <input type="time" name="hora" required class="tc-field__input" />
        <span class="tc-field__label">Hora</span>
      </label>

      <label class="tc-field tc-field--always tc-field--full">
        <select name="estado" class="tc-field__input">
          <% var _lista55 = (reserva_estados || []); if (_lista55.length) { _lista55.forEach(function (estado, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista55.length - 1 }; var _finDeLista = _lista55.length - 1; %>
          <option
            value="<%= estado[0] %>"
            <% if (estado[0] == 'Pendiente') { %>selected<% } %>
          >
            <%= estado[1] %>
          </option>
          <% }); } %>
        </select>
        <span class="tc-field__label">Estado de la cita</span>
      </label>

      <div class="tc-form__actions">
        <button type="submit" class="tc-btn tc-btn--gold">
          <span class="material-symbols-outlined text-[18px]">event_available</span>
          Guardar Cita
        </button>
        <a href="/barbero" class="tc-btn tc-btn--ghost"
          >Cancelar</a
        >
      </div>
    </form>
  </div>
</main>
<%- include('../partials/peluquero-mobile-nav', { active: "citas" }) %>


<%# Título: Crear / Editar Peluquero - TecnoCorte %>

<%- include('../partials/admin-sidebar', { active: "peluqueros" }) %>
<main class="ml-0 md:ml-64 flex-1 min-h-screen p-6 md:p-12 pb-24 md:pb-12 bg-surface">
  <%- include('../partials/panel-header') %>
  <div class="mx-auto max-w-3xl">
    <a
      href="/admin/peluqueros"
      class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-primary transition-colors hover:text-primary-container active:scale-95"
      ><span class="material-symbols-outlined text-base">arrow_back</span
      >Volver</a
    >

    <div class="mt-6 mb-8">
      <p class="tc-eyebrow mb-3">Equipo</p>
      <h1 class="tc-display text-4xl md:text-5xl">
        <% if (datos) { %>Editar<% } else { %>Nuevo<% } %>
        <span class="tc-gold-text">barbero</span>
      </h1>
      <p class="mt-3 text-on-surface-variant">
        <% if (datos) { %>
          Actualiza los datos del barbero y su barbería asignada.
        <% } else { %>
          Registra un nuevo barbero y asígnale su barbería.
        <% } %>
      </p>
    </div>

    <form method="post" enctype="multipart/form-data" class="tc-form tc-form__grid">
      
      <% if (error) { %>
      <p
        class="tc-field--full rounded-xl border border-error/40 bg-error/10 p-3 text-sm text-error"
      >
        <%= error %>
      </p>
      <% } %>

      <label class="tc-field">
        <input
          required
          type="text"
          name="nombre"
          value="<%= (datos.nombre === undefined || datos.nombre === null ? "" : datos.nombre) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Nombre</span>
      </label>

      <label class="tc-field">
        <input
          required
          type="text"
          name="apellido"
          value="<%= (datos.apellido === undefined || datos.apellido === null ? "" : datos.apellido) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Apellido</span>
      </label>

      <label class="tc-field tc-field--full">
        <input
          required
          type="email"
          name="email"
          value="<%= (datos.email === undefined || datos.email === null ? "" : datos.email) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Correo electrónico</span>
      </label>

      <label class="tc-field tc-field--full">
        <input
          type="text"
          name="telefono"
          value="<%= (datos.telefono === undefined || datos.telefono === null ? "" : datos.telefono) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Teléfono</span>
      </label>

      <label class="tc-field tc-field--always tc-field--full">
        <select name="peluqueria" required class="tc-field__input">
          <option value="">Seleccione la barbería</option>
          <% var _lista10 = (peluquerias || []); if (_lista10.length) { _lista10.forEach(function (peluqueria, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista10.length - 1 }; var _finDeLista = _lista10.length - 1; %>
          <option
            value="<%= peluqueria.id %>"
            <% if (datos && datos.peluqueria_id == peluqueria.id) { %>selected<% } %>
          >
            <%= peluqueria.nombre %>
          </option>
          <% }); } %>
        </select>
        <span class="tc-field__label">Barbería</span>
      </label>

      
      <div class="tc-field--full space-y-3">
        <p class="tc-eyebrow">Foto de perfil</p>
        <% if (datos.foto) { %>
        <img
          src="<%= datos.foto.url %>"
          alt="<%= datos.nombre %>"
          class="h-24 w-24 rounded-full border border-primary/25 object-cover"
        />
        <label class="tc-switch">
          <input type="checkbox" name="quitar_foto" />
          <span class="text-error">Quitar la foto actual</span>
        </label>
        <% } %>
        <label class="tc-field tc-field--always">
          <input type="file" name="foto" accept="image/*" class="tc-field__input" />
          <span class="tc-field__label">Imagen (JPG, PNG o WEBP)</span>
        </label>
      </div>

      <label class="tc-field tc-field--full">
        <input
          type="password"
          name="password"
          placeholder=" "
          <% if (!(datos)) { %>required<% } %>
          class="tc-field__input"
        />
        <span class="tc-field__label">Contraseña</span>
      </label>
      <span class="tc-field__hint tc-field--full">
        <% if (datos) { %>
          Déjala vacía para conservar la contraseña actual.
        <% } else { %>
          Mínimo 8 caracteres, con mayúscula, minúscula y número.
        <% } %>
      </span>

      <div class="tc-form__actions">
        <button class="tc-btn tc-btn--gold" type="submit">
          <span class="material-symbols-outlined text-[18px]">save</span>
          <% if (datos) { %>Guardar cambios<% } else { %>Crear barbero<% } %>
        </button>
        <a href="/admin/peluqueros" class="tc-btn tc-btn--ghost"
          >Cancelar</a
        >
      </div>
    </form>
  </div>
</main>
<%- include('../partials/admin-mobile-nav', { active: "peluqueros" }) %>


<%- include('../partials/peluquero-sidebar', { active: 'servicios' }) %>
<main class="flex-1 md:ml-72 min-h-screen bg-background p-6 md:p-12 space-y-8">
  <section><h1 class="font-headline text-4xl text-on-surface">Mis servicios</h1><p class="text-on-surface-variant">Solicita nuevos servicios al administrador y consulta los aprobados.</p></section>
  <form method="post" class="grid gap-3 rounded-xl bg-surface-container-low p-6 md:grid-cols-2"><input name="nombre" required placeholder="Nombre" class="rounded-md p-3"><input name="descripcion" placeholder="Descripción" class="rounded-md p-3"><input name="duracion" value="30 Minutos" placeholder="Duración" class="rounded-md p-3"><input name="minutos" type="number" min="1" max="480" value="30" class="rounded-md p-3"><input name="precio" type="number" min="0" value="0" class="rounded-md p-3"><button class="rounded-md bg-primary p-3 font-bold text-on-primary md:col-span-2">Solicitar servicio</button></form>
  <section class="space-y-3"><h2 class="text-2xl text-primary">Servicios aprobados</h2><% servicios.forEach((servicio) => { %><article class="rounded-xl border border-outline-variant/20 p-4"><strong><%= servicio.nombre %></strong> · $<%= servicio.precio %><p class="text-sm text-on-surface-variant"><%= servicio.descripcion %></p></article><% }) %></section>
  <section class="space-y-3"><h2 class="text-2xl text-primary">Mis solicitudes</h2><% solicitudes.forEach((solicitud) => { %><article class="rounded-xl border border-outline-variant/20 p-4"><strong><%= solicitud.nombre %></strong> · <%= solicitud.estado %><% if (solicitud.nota_admin) { %><p class="text-sm text-on-surface-variant"><%= solicitud.nota_admin %></p><% } %></article><% }) %></section>
</main>

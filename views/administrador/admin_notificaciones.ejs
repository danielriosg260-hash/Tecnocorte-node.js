<%# Título: Notificaciones -
TecnoCorte %>
 <%- include('../partials/admin-sidebar', { active: "notificaciones" }) %>
<main class="ml-0 md:ml-64 min-h-screen flex-1 bg-surface p-8 md:p-12 pb-24 md:pb-12">
  <%- include('../partials/panel-header') %>
  <header class="mb-10">
    <h1 class="font-headline text-4xl text-primary">Notificaciones</h1>
    <p class="mt-2 text-on-surface-variant">
      Avisos importantes del inventario y la operación.
    </p>
  </header>
  <section class="max-w-3xl space-y-4">
    
    <% var _lista31 = (notificaciones || []); if (_lista31.length) { _lista31.forEach(function (notificacion, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista31.length - 1 }; var _finDeLista = _lista31.length - 1; %>
    <article
      class="flex gap-4 rounded-xl border border-error/20 bg-error-container/10 p-5"
    >
      <span class="material-symbols-outlined mt-0.5 text-error"
        >inventory_2</span
      >
      <div>
        <p class="font-semibold text-on-surface"><%= notificacion.mensaje %></p>
        <p class="mt-1 text-xs text-on-surface-variant">
          <%= fmtFecha(notificacion.fecha, "d/m/Y H:i") %>
        </p>
      </div>
    </article>
    <% }); } else { %>
    <div
      class="rounded-xl bg-surface-container-low p-10 text-center text-on-surface-variant"
    >
      No tienes notificaciones nuevas.
    </div>
    <% } %>
  </section>
</main>
<%- include('../partials/admin-mobile-nav', { active: "notificaciones" }) %>


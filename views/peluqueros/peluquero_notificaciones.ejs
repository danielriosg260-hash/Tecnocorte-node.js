<% // Layout: dashboard %>
<%- include('../partials/peluquero-sidebar', { active: 'notificaciones' }) %>
<main class="flex-1 md:ml-72 flex flex-col min-h-screen relative bg-background">
  <header class="glass-header sticky top-0 z-40 flex justify-between items-center w-full px-6 md:px-12 py-4">
    <a class="inline-flex md:hidden" href="/barbero" aria-label="TecnoCorte"><%- include('../partials/logo') %></a>
    <div class="hidden md:block"></div>
    <a href="/barbero" class="flex items-center gap-2 text-primary uppercase tracking-widest text-sm font-bold hover:text-primary-container transition-colors active:scale-95">
      <span class="material-symbols-outlined text-base">arrow_back</span>Volver
    </a>
  </header>

  <div class="p-6 md:p-12 max-w-3xl mx-auto w-full">
    <h2 class="font-headline text-4xl text-on-surface tracking-tight mb-2">Notificaciones</h2>
    <p class="font-body text-on-surface-variant mb-10">Mensajes y avisos recientes.</p>

    <div class="space-y-4">
      <% if (notificaciones && notificaciones.length) { %>
      <% notificaciones.forEach(function(notificacion) { %>
      <article class="bg-surface-container-low rounded-xl p-6 ambient-glow flex gap-4">
        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-primary text-lg">notifications</span>
        </div>
        <div class="flex-1">
          <p class="font-body text-on-surface"><%= notificacion.mensaje %></p>
          <p class="text-on-surface-variant text-xs mt-2"><%= fmtFecha(notificacion.fecha, 'dd/MM/yyyy HH:mm') %></p>
        </div>
      </article>
      <% }); %>
      <% } else { %>
      <div class="bg-surface-container-low rounded-xl p-12 text-center ambient-glow">
        <span class="material-symbols-outlined text-5xl text-primary/30 mb-4">notifications_off</span>
        <p class="font-body text-on-surface-variant text-lg">No tienes notificaciones nuevas.</p>
      </div>
      <% } %>
    </div>
  </div>
</main>

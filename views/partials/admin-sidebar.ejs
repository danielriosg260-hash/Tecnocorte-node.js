<!-- Barra lateral del panel de administración: navegación y acción rápida -->
<%
  var activo = typeof active !== 'undefined' ? active : '';
  var clases = function (nombre) {
    return 'panel-glass-link flex items-center space-x-4 px-4 py-3 ' + (activo === nombre ? 'panel-glass-link--active' : 'text-on-surface-variant');
  };
  var pendientesServicios = typeof solicitudes_servicio_pendientes !== 'undefined' ? solicitudes_servicio_pendientes : 0;
  var pendientesMensajes = typeof mensajes_no_leidos !== 'undefined' ? mensajes_no_leidos : 0;
  var pendientesNotificaciones = typeof notificaciones_no_leidas !== 'undefined' ? notificaciones_no_leidas : 0;
  var pendientesErrores = typeof errores_pendientes !== 'undefined' ? errores_pendientes : 0;
%>
<nav class="admin-sidebar panel-glass hidden md:flex fixed left-0 top-0 z-40 flex-col p-4 w-64 h-screen">
  <div class="tc-panel-brand flex items-center gap-3 border-b border-primary/10 pb-5">
    <%- include('logo', { logo_class: 'h-12 w-12' }) %>
    <div class="min-w-0">
      <p class="font-headline text-lg font-bold leading-tight text-primary-container">TecnoCorte</p>
      <p class="truncate font-label text-[0.6rem] uppercase tracking-[0.16em] text-on-surface-variant">Administración</p>
    </div>
  </div>

  <div class="mt-4 flex-1 space-y-1 overflow-y-auto">
    <a class="<%= clases('dashboard') %>" href="/admin">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 0">dashboard</span>
      <span class="font-label uppercase text-xs tracking-widest">Dashboard</span>
    </a>
    <a class="<%= clases('inicio') %>" href="/admin/editar-inicio">
      <span class="material-symbols-outlined">home_work</span>
      <span class="font-label uppercase text-xs tracking-widest">Inicio</span>
    </a>
    <a class="panel-glass-link flex items-center space-x-4 px-4 py-3 text-primary" href="/?vista=publica" target="_blank" rel="noopener" title="Abrir el sitio público">
      <span class="material-symbols-outlined">open_in_new</span>
      <span class="font-label uppercase text-xs tracking-widest">Ver sitio</span>
    </a>
    <a class="<%= clases('reservas') %>" href="/admin/reservas">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 1">calendar_month</span>
      <span class="font-label uppercase text-xs tracking-widest">Citas</span>
    </a>
    <a class="<%= clases('peluqueros') %>" href="/admin/peluqueros">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 0">content_cut</span>
      <span class="font-label uppercase text-xs tracking-widest">Barberos</span>
    </a>
    <a class="<%= clases('servicios') %>" href="/admin/solicitudes-servicios">
      <span class="material-symbols-outlined">design_services</span>
      <span class="font-label uppercase text-xs tracking-widest">Servicios</span>
      <% if (pendientesServicios) { %>
      <span class="ml-auto flex h-5 min-w-5 items-center justify-center rounded-full bg-error px-1 text-[10px] font-bold text-on-error"><%= pendientesServicios %></span>
      <% } %>
    </a>
    <a class="<%= clases('usuarios') %>" href="/admin/usuarios">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 0">group</span>
      <span class="font-label uppercase text-xs tracking-widest">Usuarios</span>
    </a>
    <a class="<%= clases('peluquerias') %>" href="/admin/peluquerias">
      <span class="material-symbols-outlined">storefront</span>
      <span class="font-label uppercase text-xs tracking-widest">Barberías</span>
    </a>
    <a class="<%= clases('productos') %>" href="/admin/productos">
      <span class="material-symbols-outlined">inventory_2</span>
      <span class="font-label uppercase text-xs tracking-widest">Productos</span>
    </a>
    <a class="<%= clases('pedidos') %>" href="/admin/pedidos">
      <span class="material-symbols-outlined">shopping_bag</span>
      <span class="font-label uppercase text-xs tracking-widest">Pedidos</span>
    </a>
    <a class="<%= clases('mensajes') %>" href="/admin/mensajes">
      <span class="material-symbols-outlined">mail</span>
      <span class="font-label uppercase text-xs tracking-widest">Mensajes</span>
      <% if (pendientesMensajes) { %>
      <span class="ml-auto flex h-5 min-w-5 items-center justify-center rounded-full bg-error px-1 text-[10px] font-bold text-on-error"><%= pendientesMensajes %></span>
      <% } %>
    </a>
    <a class="<%= clases('notificaciones') %>" href="/admin/notificaciones">
      <span class="material-symbols-outlined">notifications</span>
      <span class="font-label uppercase text-xs tracking-widest">Notificaciones</span>
      <% if (pendientesNotificaciones) { %>
      <span class="ml-auto flex h-5 min-w-5 items-center justify-center rounded-full bg-error px-1 text-[10px] font-bold text-on-error"><%= pendientesNotificaciones %></span>
      <% } %>
    </a>
    <a class="<%= clases('ingresos') %>" href="/admin/ingresos">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 0">login</span>
      <span class="font-label uppercase text-xs tracking-widest">Ingresos</span>
    </a>
    <a class="<%= clases('acciones') %>" href="/admin/acciones">
      <span class="material-symbols-outlined">history</span>
      <span class="font-label uppercase text-xs tracking-widest">Auditoría</span>
    </a>
    <a class="<%= clases('errores') %>" href="/admin/errores">
      <span class="material-symbols-outlined">bug_report</span>
      <span class="font-label uppercase text-xs tracking-widest">Errores</span>
      <% if (pendientesErrores) { %>
      <span class="ml-auto flex h-5 min-w-5 items-center justify-center rounded-full bg-error px-1 text-[10px] font-bold text-on-error"><%= pendientesErrores %></span>
      <% } %>
    </a>
    <a class="<%= clases('horarios') %>" href="/admin/horarios">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 0">schedule</span>
      <span class="font-label uppercase text-xs tracking-widest">Horarios</span>
    </a>
    <a class="<%= clases('galeria') %>" href="/admin/galeria">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 0">photo_library</span>
      <span class="font-label uppercase text-xs tracking-widest">Galería</span>
    </a>
    <a class="<%= clases('configuracion') %>" href="/admin/configuracion">
      <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 0">tune</span>
      <span class="font-label uppercase text-xs tracking-widest">Configuración</span>
    </a>
  </div>

  <%# Acciones fijas: nueva cita %>
  <div class="mt-4 shrink-0 space-y-1 border-t border-primary/10 pt-3">
    <a href="/admin/reservas/nueva" class="panel-glass-cta flex w-full items-center justify-center gap-2 rounded-xl px-3 py-3 text-center font-label text-xs font-bold uppercase tracking-widest active:scale-95">
      <span class="material-symbols-outlined text-lg">add</span>
      Nueva cita
    </a>
  </div>
</nav>

<% // Layout: dashboard %>
<%- include('../partials/admin-sidebar', { active: 'peluquerias' }) %>
<main class="ml-64 flex-1 p-12">
<div class="flex justify-between items-center mb-10"><div><h1 class="font-headline text-4xl text-primary">Barberías</h1><p class="text-on-surface-variant mt-2">Administra las sedes disponibles para reservar.</p></div><a class="btn-gold-gradient py-3 px-5 rounded font-bold" href="/admin/peluquerias/nueva">+ Nueva barbería</a></div>
<div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
<% if (peluquerias && peluquerias.length) { peluquerias.forEach(function(peluqueria) { %>
<article class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/20"><span class="material-symbols-outlined text-primary text-4xl">storefront</span><h2 class="font-headline text-2xl mt-4"><%= peluqueria.nombre %></h2><p class="text-on-surface-variant mt-2"><%= peluqueria.ubicacion %></p><p class="text-on-surface-variant text-sm mt-1"><%= peluqueria.telefono %></p><div class="flex gap-4 mt-6"><a class="text-primary" href="/admin/peluquerias/<%= peluqueria.id %>/editar">Editar</a><form method="post" action="/admin/peluquerias/<%= peluqueria.id %>/eliminar"><!-- csrf: auth JWT --><button class="text-error" data-confirm="¿Eliminar esta barbería?">Eliminar</button></form></div></article>
<% }); } else { %>
<p class="text-on-surface-variant">Aún no hay barberías.</p>
<% } %>
</div>
</main>
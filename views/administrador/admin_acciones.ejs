<%- include('../partials/admin-sidebar', { active: 'acciones' }) %>
<main class="ml-64 flex-1 p-12"><h1 class="font-headline text-4xl text-primary mb-8">Auditoría de acciones</h1><div class="overflow-x-auto rounded-xl border border-outline-variant/20"><table class="w-full text-left text-sm"><thead><tr class="border-b border-outline-variant/20"><th class="p-4">Fecha</th><th class="p-4">Usuario</th><th class="p-4">Acción</th><th class="p-4">Modelo</th><th class="p-4">IP</th></tr></thead><tbody><% acciones.forEach((accion) => { %><tr class="border-b border-outline-variant/10"><td class="p-4"><%= fmtFecha(accion.createdAt, 'dd/MM/yyyy HH:mm') %></td><td class="p-4"><%= accion.usuario ? `${accion.usuario.nombre} ${accion.usuario.apellido}` : 'Anónimo' %></td><td class="p-4"><%= accion.accion %></td><td class="p-4"><%= accion.modelo || '-' %></td><td class="p-4"><%= accion.ip || '-' %></td></tr><% }) %></tbody></table></div></main>

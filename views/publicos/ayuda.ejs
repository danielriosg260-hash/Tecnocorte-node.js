<!-- Página de contacto y ayuda con formulario de mensaje y preguntas frecuentes -->
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Contactos / Ayuda - TecnoCorte</title>
    <%- include('../partials/favicon') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Noto+Serif:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
    <%- include('../partials/tema') %>
    <link rel="stylesheet" href="/css/publicos/ayuda.css" />
  </head>

  <body
    class="flex min-h-screen flex-col bg-surface font-body text-on-surface antialiased"
  >
    
    <%- include('../partials/site-nav', { active: "contactos" }) %>

    <main
      class="tc-contact-page mx-auto flex w-full max-w-6xl flex-grow px-6 pb-24 pt-32 md:px-12"
    >
      <div class="w-full">
        <header class="tc-contact-hero mb-12 text-center">
          <div class="tc-contact-badge mx-auto mb-5">
            <span class="material-symbols-outlined">support_agent</span>
            Estamos para ayudarte
          </div>
          <h1
            class="mb-4 font-headline text-5xl tracking-tight text-primary-container md:text-6xl"
          >
            Contactos
          </h1>
          <p class="text-lg text-on-surface-variant">
            ¿Necesitas ayuda? Escríbenos y con gusto te atendemos.
          </p>
          <div class="tc-contact-highlights mx-auto mt-6">
            <span><span class="material-symbols-outlined">schedule</span> Atención personalizada</span>
            <span><span class="material-symbols-outlined">reply</span> Respondemos pronto</span>
          </div>
        </header>

        <!-- Tarjetas de información de contacto -->
        <div class="tc-contact-cards mb-12 grid grid-cols-1 gap-5 md:grid-cols-3">
          <div
            class="tc-contact-card rounded-[24px] bg-surface-container-low p-6 text-center ambient-glow ghost-border transition-colors hover:bg-surface-container"
          >
            <span
              class="material-symbols-outlined mb-4 text-4xl text-primary"
              style="font-variation-settings: &quot;FILL&quot; 1"
              >call</span
            >
            <h3 class="mb-2 font-headline text-xl">Teléfono</h3>
            <p class="text-on-surface-variant">+57 300 123 4567</p>
          </div>
          <div
            class="tc-contact-card rounded-[24px] bg-surface-container-low p-6 text-center ambient-glow ghost-border transition-colors hover:bg-surface-container"
          >
            <span
              class="material-symbols-outlined mb-4 text-4xl text-primary"
              style="font-variation-settings: &quot;FILL&quot; 1"
              >mail</span
            >
            <h3 class="mb-2 font-headline text-xl">Correo</h3>
            <p class="text-on-surface-variant">tecnocorte083@gmail.com</p>
          </div>
          <div
            class="tc-contact-card rounded-[24px] bg-surface-container-low p-6 text-center ambient-glow ghost-border transition-colors hover:bg-surface-container"
          >
            <span
              class="material-symbols-outlined mb-4 text-4xl text-primary"
              style="font-variation-settings: &quot;FILL&quot; 1"
              >location_on</span
            >
            <h3 class="mb-2 font-headline text-xl">Dirección</h3>
            <p class="text-on-surface-variant">Zona SENA, Itagüí</p>
          </div>
        </div>

        
        <% if (exito) { %>
        <div
          class="mb-6 rounded-lg border border-primary/40 bg-primary/10 p-4 text-primary"
        >
          <%= exito %>
        </div>
        <% } %> <% if (error) { %>
        <div
          class="mb-6 rounded-lg border border-error/40 bg-error-container/20 p-4 text-error"
        >
          <%= error %>
        </div>
        <% } %>

        <div class="tc-contact-lower">
        <!-- Formulario de envío de mensaje al administrador -->
        <section
          class="mb-8 rounded-[28px] bg-surface-container-low p-8 md:p-12 ambient-glow ghost-border"
        >
          <h2 class="mb-2 font-headline text-2xl text-primary-container">
            Envíanos un mensaje
          </h2>
          <p class="mb-6 text-on-surface-variant">
            El administrador recibirá tu consulta en el panel.
          </p>
          <form method="post" class="grid gap-4">
            
            <div class="grid gap-4 md:grid-cols-2">
              <input
                required
                name="nombre"
                placeholder="Tu nombre"
                value="<%= (valores && valores.nombre) || prefill_nombre || '' %>"
                aria-label="Tu nombre"
                class="rounded-md border-0 bg-surface-container-high p-3 text-on-surface focus:outline-none"
              />
              <input
                required
                type="email"
                name="email"
                placeholder="Tu correo"
                value="<%= (valores && valores.email) || prefill_email || '' %>"
                aria-label="Tu correo electrónico"
                class="rounded-md border-0 bg-surface-container-high p-3 text-on-surface focus:outline-none"
              />
            </div>
            <% if (prefill_nombre) { %>
            <p class="-mt-2 text-xs text-on-surface-variant">
              Completamos tu nombre y correo con los datos de tu cuenta.
            </p>
            <% } %>
            <label for="tipo" class="text-sm font-semibold text-on-surface"
              >Tipo de mensaje</label
            >
            <select
              id="tipo"
              required
              name="tipo"
              class="rounded-md border-0 bg-surface-container-high p-3 text-on-surface focus:outline-none"
            >
              <option value="" disabled <% if (!valores.tipo) { %>selected<% } %>>
                Selecciona el motivo de tu consulta
              </option>
              <% var _lista66 = (tipos_mensaje || []); if (_lista66.length) { _lista66.forEach(function ([valor, etiqueta], indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista66.length - 1 }; var _finDeLista = _lista66.length - 1; %>
              <option
                value="<%= valor %>"
                <% if (valores.tipo == valor) { %>selected<% } %>
              >
                <%= etiqueta %>
              </option>
              <% }); } %>
            </select>
            <textarea
              required
              name="mensaje"
              rows="5"
              placeholder="Escribe tu mensaje"
              aria-label="Mensaje de contacto"
              class="rounded-md border-0 bg-surface-container-high p-3 text-on-surface focus:outline-none"
            >
<%= valores.mensaje || '' %></textarea>
            <button
              class="gold-gradient w-full rounded-md py-3 font-bold uppercase tracking-widest text-on-primary md:w-auto md:px-8"
              type="submit"
            >
              Enviar mensaje
            </button>
          </form>
        </section>

        <!-- Sección de preguntas frecuentes -->
        <div
          class="rounded-[28px] bg-surface-container-low p-8 md:p-12 ambient-glow ghost-border"
        >
          <h2 class="mb-6 font-headline text-2xl text-primary-container">
            Preguntas frecuentes
          </h2>
          <div class="space-y-4">
            <div class="rounded-lg border border-outline-variant/15 p-5">
              <h3 class="mb-1 font-semibold text-on-surface">
                ¿Cómo reservo una cita?
              </h3>
              <p class="text-sm text-on-surface-variant">
                Inicia sesión como cliente, entra a “Reservar”, elige servicio,
                barbero, barbería, fecha y hora, y confirma.
              </p>
            </div>
            <div class="rounded-lg border border-outline-variant/15 p-5">
              <h3 class="mb-1 font-semibold text-on-surface">
                ¿Puedo comprar sin registrarme?
              </h3>
              <p class="text-sm text-on-surface-variant">
                Sí. Agrega productos al carrito y, al finalizar la compra, te
                pediremos iniciar sesión o registrarte.
              </p>
            </div>
            <div class="rounded-lg border border-outline-variant/15 p-5">
              <h3 class="mb-1 font-semibold text-on-surface">
                ¿Dónde puedo ver mis citas y pedidos?
              </h3>
              <p class="text-sm text-on-surface-variant">
                En tu perfil. Allí aparecen las citas reservadas y los pedidos
                realizados.
              </p>
            </div>
          </div>
          <div class="mt-10 text-center">
            <a
              href="/"
              class="inline-flex justify-center rounded-md px-8 py-3 text-sm font-bold uppercase tracking-widest text-on-primary gold-gradient transition-all active:scale-95"
              >Volver al inicio</a
            >
          </div>
        </div>
        </div>
      </div>
    </main>

    <!-- Pie de página con enlaces de utilidad -->
    <footer
      class="flex w-full flex-col items-center gap-8 border-t border-outline-variant/10 bg-surface-container-lowest px-8 pb-8 pt-16"
    >
      <div class="font-headline text-xl font-bold text-primary">TecnoCorte</div>
      <nav
        class="flex flex-wrap justify-center gap-6 text-sm text-on-surface-variant"
      >
        <a
          class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100"
          href="/politicas"
          >Privacidad</a
        >
          <a class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100" href="/politicas">Políticas de Privacidad y del Proyecto</a>
        <a
          class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100"
          href="/ayuda"
          >Términos</a
        >
        <a
          class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100"
          href="/ayuda"
          >Soporte</a
        >
        <a
          class="opacity-80 transition-colors duration-300 hover:text-primary hover:opacity-100"
          href="/ayuda"
          >Franquicias</a
        >
      </nav>
      <div class="mt-4 text-center text-sm text-on-surface-variant opacity-60">
        © 2026 TecnoCorte. Todos los derechos reservados.
      </div>
    </footer>
  </body>
</html>


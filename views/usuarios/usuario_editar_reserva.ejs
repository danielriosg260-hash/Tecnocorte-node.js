<main class="max-w-2xl mx-auto p-8 md:p-12">
  <a class="text-primary" href="/perfil"
    >← Volver a mi perfil</a
  >
  <div class="bg-surface-container-low rounded-xl p-8 mt-6">
    <h1 class="font-headline text-3xl mb-6">Modificar cita</h1>
    <% if (!(reserva.peluquero.activo)) { %>
    <div
      class="mb-4 flex items-start gap-2 rounded-md border border-error/30 bg-error-container/15 p-3 text-sm text-error"
    >
      <span class="material-symbols-outlined text-base">person_off</span
      ><span
        >Tu barbero está suspendido y no podrá atender esta cita. Selecciona
        otro barbero para reagendarla.</span
      >
    </div>
    <% } %><% if (error) { %>
    <p class="text-error mb-4"><%= error %></p>
    <% } %>
    
    <form method="post" class="space-y-5">
      <select
        name="servicio"
        class="w-full bg-surface-container-high p-3 rounded"
      >
        <% var _lista74 = (servicios || []); if (_lista74.length) { _lista74.forEach(function (servicio, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista74.length - 1 }; var _finDeLista = _lista74.length - 1; %>
        <option
          value="<%= servicio.nombre %>"
          <% if (reserva.servicio == servicio.nombre) { %>selected<% } %>
        >
          <%= servicio.nombre %> · <%= servicio.duracion %>
        </option>
        <% }); } %></select
      ><select
        name="peluquero"
        class="w-full bg-surface-container-high p-3 rounded"
      >
        <% var _lista75 = (peluqueros || []); if (_lista75.length) { _lista75.forEach(function (barbero, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista75.length - 1 }; var _finDeLista = _lista75.length - 1; %>
        <option
          value="<%= barbero.id %>"
          <% if (reserva.peluquero_id == barbero.id) { %>selected<% } %>
        >
          <%= barbero.nombre %> <%= barbero.apellido %>
        </option>
        <% }); } %></select
      ><select
        name="peluqueria"
        class="w-full bg-surface-container-high p-3 rounded"
      >
        <% var _lista76 = (peluquerias || []); if (_lista76.length) { _lista76.forEach(function (peluqueria, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista76.length - 1 }; var _finDeLista = _lista76.length - 1; %>
        <option
          value="<%= peluqueria.id %>"
          <% if (reserva.peluqueria_id == peluqueria.id) { %>selected<% } %>
        >
          <%= peluqueria.nombre %>
        </option>
        <% }); } %>
      </select>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <input
          required
          type="date"
          name="fecha"
          value="<%= fmtFecha(reserva.fecha, "Y-m-d") %>"
          class="bg-surface-container-high p-3 rounded"
        /><input
          required
          type="time"
          name="hora"
          value="<%= fmtHora(reserva.hora) %>"
          class="bg-surface-container-high p-3 rounded"
        />
      </div>
      <button class="btn-gold-gradient px-5 py-3 rounded font-bold">
        Guardar cambios
      </button>
    </form>
  </div>
</main>


<%- include('../partials/admin-sidebar', { active: 'dashboard' }) %>
<main class="ml-0 md:ml-64 flex-1 min-h-screen p-6 md:p-12 pb-24 md:pb-12">
  <%- include('../partials/panel-header') %>
  <header class="mb-10 flex flex-wrap items-start justify-between gap-5 pr-16">
    <div>
      <h1 class="font-headline text-4xl text-primary">
        Resumen administrativo
      </h1>
      <p class="mt-2 text-on-surface-variant">
        Control de citas, clientes e ingresos de TecnoCorte.
      </p>
    </div>
    <a
      href="/admin/reservas/nueva"
      class="inline-flex shrink-0 items-center gap-2 rounded-full border border-primary/35 bg-primary/10 px-4 py-2.5 text-sm font-bold text-primary transition-all hover:bg-primary hover:text-on-primary"
      ><span class="material-symbols-outlined text-lg">add</span>Nueva cita</a
    >
  </header>
  <div class="mb-8 flex flex-wrap gap-3">
    <a href="/admin/exportar/reservas" class="inline-flex items-center gap-2 rounded-lg border border-primary/25 bg-primary/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-primary"><span class="material-symbols-outlined text-base">download</span>Excel de reservas</a>
    <a href="/admin/exportar/pedidos" class="inline-flex items-center gap-2 rounded-lg border border-primary/25 bg-primary/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-primary"><span class="material-symbols-outlined text-base">download</span>Excel de pedidos</a>
  </div>
  
  <section class="grid sm:grid-cols-2 xl:grid-cols-6 gap-4 mb-10">
    <div class="bg-surface-container-low rounded-xl p-6">
      <p class="text-on-surface-variant text-sm">Ingresos totales</p>
      <p class="font-headline text-3xl text-primary mt-2">$<%= total %></p>
    </div>
    <div class="bg-surface-container-low rounded-xl p-6">
      <p class="text-on-surface-variant text-sm">Servicios completados</p>
      <p class="font-headline text-3xl mt-2">$<%= ventas_servicios %></p>
    </div>
    <div class="bg-surface-container-low rounded-xl p-6">
      <p class="text-on-surface-variant text-sm">Ventas de tienda</p>
      <p class="font-headline text-3xl mt-2">$<%= ventas_productos %></p>
    </div>
    <div class="bg-surface-container-low rounded-xl p-6">
      <p class="text-on-surface-variant text-sm">Clientes</p>
      <p class="font-headline text-3xl mt-2"><%= total_clientes %></p>
    </div>
    <div class="bg-surface-container-low rounded-xl p-6 border border-primary/20">
      <p class="text-on-surface-variant text-sm">Citas hoy</p>
      <p class="font-headline text-3xl text-primary mt-2"><%= citas_hoy %></p>
    </div>
    <div class="bg-surface-container-low rounded-xl p-6 border border-primary/20">
      <p class="text-on-surface-variant text-sm">Pedidos pendientes</p>
      <p class="font-headline text-3xl text-primary mt-2"><%= pedidos_pendientes %></p>
    </div>
  </section>
  <section class="grid lg:grid-cols-2 gap-8">
    <div class="bg-surface-container-low rounded-xl p-7">
      <div class="mb-6 flex items-center justify-between"><h2 class="font-headline text-2xl">Estado de las citas</h2><span class="material-symbols-outlined text-primary">bar_chart</span></div>
      
      <% var _lista2 = Object.entries(estados || {}); if (_lista2.length) { _lista2.forEach(function ([estado, cantidad], indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista2.length - 1 }; var _finDeLista = _lista2.length - 1; %>
      <div class="mb-5">
        <div class="flex justify-between text-sm mb-2">
          <span><%= estado %></span><span><%= cantidad %></span>
        </div>
        <div class="h-3 bg-surface-container-high rounded-full overflow-hidden">
          <div
            class="h-full bg-primary rounded-full"
            style="width: <%= Math.round((cantidad / maximo) * 100) %>%"
          ></div>
        </div>
      </div>
      <% }); } %>
    </div>
    <div class="bg-surface-container-low rounded-xl p-7">
      <div class="flex justify-between mb-6">
        <h2 class="font-headline text-2xl">Últimas citas</h2>
        <a class="text-primary text-sm" href="/admin/reservas"
          >Ver todas</a
        >
      </div>
      
      <div class="space-y-4">
        <% var _lista3 = (ultimas_reservas || []); if (_lista3.length) { _lista3.forEach(function (reserva, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista3.length - 1 }; var _finDeLista = _lista3.length - 1; %>
        <div
          class="flex justify-between border-b border-outline-variant/20 pb-3"
        >
          <div>
            <p><%= reserva.cliente.nombre %> · <%= reserva.servicio %></p>
            <p class="text-xs text-on-surface-variant">
              <%= reserva.peluquero.nombre %> · <%= reserva.fecha %> <%= reserva.hora %>
            </p>
          </div>
          <span class="text-xs text-primary"><%= reserva.estado %></span>
        </div>
        <% }); } else { %>
        <p class="text-on-surface-variant">No hay citas.</p>
        <% } %>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/admin-mobile-nav', { active: "dashboard" }) %>


<% // Layout: dashboard %>
<%- include('../partials/admin-sidebar', { active: 'productos' }) %>
<main class="ml-64 flex-1 p-12">
<div class="flex justify-between items-center mb-10"><div><h1 class="font-headline text-4xl text-primary">Productos</h1><p class="text-on-surface-variant mt-2">Productos que se muestran en la tienda.</p></div><a class="btn-gold-gradient py-3 px-5 rounded font-bold" href="/admin/productos/nuevo">+ Añadir producto</a></div>
<div class="bg-surface-container-low rounded-xl overflow-hidden"><table class="w-full text-left"><thead class="bg-surface-container-high text-on-surface-variant text-xs uppercase"><tr><th class="p-4">Producto</th><th class="p-4">Categoría</th><th class="p-4">Precio</th><th class="p-4">Stock</th><th class="p-4">Estado</th><th class="p-4">Acciones</th></tr></thead><tbody>
<% if (productos && productos.length) { productos.forEach(function(producto) { %>
<tr class="border-t border-outline-variant/20"><td class="p-4 font-semibold"><%= producto.nombre %></td><td class="p-4"><%= producto.categoria_display %></td><td class="p-4"><%= fmtMoneda(producto.precio || 0) %></td><td class="p-4"><%= producto.stock || 0 %></td><td class="p-4"><% if (producto.disponible) { %>Disponible<% } else { %>No disponible<% } %></td><td class="p-4"><a class="text-primary mr-3" href="/admin/productos/<%= producto.id %>/editar">Editar</a><form class="inline" method="post" action="/admin/productos/<%= producto.id %>/eliminar"><!-- csrf: auth JWT --><button class="text-error" data-confirm="¿Eliminar este producto?">Eliminar</button></form></td></tr>
<% }); } else { %>
<tr><td class="p-8 text-on-surface-variant" colspan="6">No hay productos.</td></tr>
<% } %>
</tbody></table></div>
</main>
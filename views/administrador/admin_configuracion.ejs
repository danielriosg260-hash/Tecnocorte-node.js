<%- include('../partials/admin-sidebar', { active: 'configuracion' }) %>
<main class="ml-64 flex-1 p-12"><h1 class="font-headline text-4xl text-primary mb-8">Configuración general</h1>
  <form method="post" class="grid gap-4 max-w-3xl"><input name="sitio_nombre" value="<%= configuracion.sitio_nombre %>" placeholder="Nombre del sitio" class="rounded-md p-3"><input name="correo_contacto" value="<%= configuracion.correo_contacto %>" placeholder="Correo de contacto" class="rounded-md p-3"><input name="texto_aviso" value="<%= configuracion.texto_aviso %>" placeholder="Aviso" class="rounded-md p-3"><textarea name="mensaje_mantenimiento" class="rounded-md p-3"><%= configuracion.mensaje_mantenimiento %></textarea><input name="servicio_destacado_1" value="<%= configuracion.servicio_destacado_1 %>" placeholder="Servicio destacado 1" class="rounded-md p-3"><input name="servicio_destacado_2" value="<%= configuracion.servicio_destacado_2 %>" placeholder="Servicio destacado 2" class="rounded-md p-3"><% ['registro_abierto','mostrar_telefonos','mostrar_ubicaciones','mostrar_galeria','mostrar_calificaciones','modo_mantenimiento'].forEach((campo) => { %><label><input type="checkbox" name="<%= campo %>" <%= configuracion[campo] ? 'checked' : '' %>> <%= campo %></label><% }) %><button class="rounded-md bg-primary p-3 font-bold text-on-primary">Guardar configuración</button></form>
</main>

<%# Título: TecnoCorte - EditarNueva barbería %>

<%- include('../partials/admin-sidebar', { active: 'peluquerias' }) %>
<main class="ml-0 md:ml-64 flex-1 p-6 md:p-12 pb-24 md:pb-12">
  <%- include('../partials/panel-header') %>
  <div class="max-w-3xl mx-auto">
    <a href="/admin/peluquerias" class="text-primary inline-flex items-center gap-1"
      >← Volver a barberías</a
    >

    <div class="mt-6 mb-8">
      <p class="tc-eyebrow mb-3">Sedes</p>
      <h1 class="tc-display text-4xl md:text-5xl">
        <% if (peluqueria) { %>Editar<% } else { %>Nueva<% } %>
        <span class="tc-gold-text">barbería</span>
      </h1>
      <p class="mt-3 text-on-surface-variant">
        Datos de la sede que ven los clientes al reservar. Los campos se
        iluminan en dorado al enfocarlos.
      </p>
    </div>

    <form method="post" enctype="multipart/form-data" class="tc-form tc-form__grid">
      

      <label class="tc-field tc-field--full">
        <input
          required
          name="nombre"
          value="<%= ((peluqueria.nombre === undefined || peluqueria.nombre === null || peluqueria.nombre === '') ? "" : peluqueria.nombre) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Nombre de la barbería</span>
      </label>

      <label class="tc-field">
        <input
          required
          name="ubicacion"
          value="<%= ((peluqueria.ubicacion === undefined || peluqueria.ubicacion === null || peluqueria.ubicacion === '') ? "" : peluqueria.ubicacion) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Dirección o ubicación</span>
      </label>

      <label class="tc-field">
        <input
          required
          name="telefono"
          value="<%= ((peluqueria.telefono === undefined || peluqueria.telefono === null || peluqueria.telefono === '') ? "" : peluqueria.telefono) %>"
          placeholder=" "
          class="tc-field__input"
        />
        <span class="tc-field__label">Teléfono</span>
      </label>

      <label class="tc-field tc-field--full">
        <textarea name="descripcion" rows="4" placeholder=" " class="tc-field__input"
        ><%= ((peluqueria.descripcion === undefined || peluqueria.descripcion === null || peluqueria.descripcion === '') ? "" : peluqueria.descripcion) %></textarea>
        <span class="tc-field__label">Descripción del local</span>
      </label>

      
      <div class="tc-field--full space-y-3">
        <p class="tc-eyebrow">Foto de portada</p>
        <% if (peluqueria.imagen) { %>
        <img
          src="<%= peluqueria.imagen %>"
          alt="<%= peluqueria.nombre %>"
          class="h-48 w-full rounded-xl border border-primary/25 object-cover"
        />
        <% } %>
        <label class="tc-field tc-field--always">
          <input type="file" name="imagen" accept="image/*" class="tc-field__input" />
          <span class="tc-field__label">Imagen (JPG, PNG o WEBP)</span>
        </label>
        <% if (peluqueria.imagen) { %>
        <span class="tc-field__hint"
          >Sube una nueva imagen para reemplazar la actual.</span
        >
        <% } %>
      </div>

      <label class="tc-field tc-field--always">
        <select name="dueno" class="tc-field__input">
          <option value="">— Sin asignar —</option>
          <% var _lista9 = (barberos || []); if (_lista9.length) { _lista9.forEach(function (barbero, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista9.length - 1 }; var _finDeLista = _lista9.length - 1; %>
          <option
            value="<%= barbero.id %>"
            <% if (peluqueria.dueno_id == barbero.id) { %>selected<% } %>
          >
            <%= barbero.nombre %> <%= barbero.apellido %>
          </option>
          <% }); } %>
        </select>
        <span class="tc-field__label">Barbero encargado</span>
      </label>

      <div class="tc-form__actions">
        <button class="tc-btn tc-btn--gold" type="submit">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Guardar barbería
        </button>
        <a href="/admin/peluquerias" class="tc-btn tc-btn--ghost"
          >Cancelar</a
        >
      </div>
    </form>
  </div>
</main>
<%- include('../partials/admin-mobile-nav', { active: "peluquerias" }) %>


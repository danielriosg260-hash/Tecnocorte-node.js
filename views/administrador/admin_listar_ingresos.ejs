<%# Título: Registro de
Ingresos - TecnoCorte %>
 <%- include('../partials/admin-sidebar', { active: "ingresos" }) %>
<main class="ml-0 md:ml-64 flex-1 min-h-screen p-6 md:p-12 pb-24 md:pb-12 bg-surface">
  <%- include('../partials/panel-header') %>
  <header class="flex flex-wrap justify-between items-end gap-4 mb-8 md:mb-12">
    <div>
      <h2 class="font-headline text-3xl md:text-4xl text-on-background tracking-tight">
        Registro de Ingresos
      </h2>
      <p class="font-body text-on-surface-variant mt-2">
        Cada vez que alguien inicia sesión se guarda aquí.
      </p>
    </div>
    <div class="flex flex-wrap gap-2 md:gap-4">
      
      <a
        href="/admin/ingresos"
        class="px-4 py-2 rounded-full font-label text-xs uppercase tracking-widest font-bold <% if (!(rol_filtro)) { %>bg-primary text-on-primary<% } else { %>bg-surface-container-highest text-on-surface-variant<% } %>"
        >Todos</a
      >
      <a
        href="/admin/ingresos?rol=Cliente"
        class="px-4 py-2 rounded-full font-label text-xs uppercase tracking-widest <% if (rol_filtro == 'Cliente') { %>bg-primary text-on-primary font-bold<% } else { %>bg-surface-container-highest text-on-surface-variant<% } %>"
        >Clientes</a
      >
      <a
        href="/admin/ingresos?rol=Barbero"
        class="px-4 py-2 rounded-full font-label text-xs uppercase tracking-widest <% if (rol_filtro == 'Barbero') { %>bg-primary text-on-primary font-bold<% } else { %>bg-surface-container-highest text-on-surface-variant<% } %>"
        >Barberos</a
      >
      <a
        href="/admin/ingresos?rol=Admin"
        class="px-4 py-2 rounded-full font-label text-xs uppercase tracking-widest <% if (rol_filtro == 'Admin') { %>bg-primary text-on-primary font-bold<% } else { %>bg-surface-container-highest text-on-surface-variant<% } %>"
        >Administradores</a
      >
    </div>
  </header>
  <div
    class="bg-surface-container-low rounded-lg ambient-shadow overflow-hidden"
  >
    <div class="table-responsive">
    <div class="min-w-[760px]">
    <div
      class="grid grid-cols-12 gap-6 px-8 py-6 border-b border-surface-container-highest bg-surface-container-high/50"
    >
      <div
        class="col-span-4 font-label text-xs uppercase tracking-widest text-on-surface-variant"
      >
        Usuario
      </div>
      <div
        class="col-span-2 font-label text-xs uppercase tracking-widest text-on-surface-variant"
      >
        Rol
      </div>
      <div
        class="col-span-3 font-label text-xs uppercase tracking-widest text-on-surface-variant"
      >
        Fecha y hora
      </div>
      <div
        class="col-span-3 font-label text-xs uppercase tracking-widest text-on-surface-variant"
      >
        IP
      </div>
    </div>
    <div class="divide-y divide-surface-container-highest">
      
      <% var _lista24 = (ingresos || []); if (_lista24.length) { _lista24.forEach(function (ingreso, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista24.length - 1 }; var _finDeLista = _lista24.length - 1; %>
      <div class="grid grid-cols-12 gap-6 px-8 py-5 items-center">
        <div class="col-span-4">
          <p class="font-body text-base text-on-background font-medium">
            <%= ingreso.usuario.nombre %> <%= ingreso.usuario.apellido %>
          </p>
          <p class="font-body text-sm text-on-surface-variant">
            <%= ingreso.usuario.email %>
          </p>
        </div>
        <div class="col-span-2">
          <span
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-label uppercase tracking-widest <% if (ingreso.rol == 'Admin') { %>bg-primary/10 text-primary border border-primary/20<% } else if (ingreso.rol == 'Barbero') { %>bg-secondary-container/20 text-secondary border border-secondary-container/30<% } else { %>bg-surface-container-highest text-on-surface-variant<% } %>"
            ><%= ingreso.rol %></span
          >
        </div>
        <div class="col-span-3 font-body text-sm text-on-surface">
          <%= fmtFecha(ingreso.fecha, "d M Y") %> - <%= fmtHora(ingreso.fecha) %>
        </div>
        <div class="col-span-3 font-body text-sm text-on-surface-variant">
          <%= ((ingreso.ip === undefined || ingreso.ip === null || ingreso.ip === '') ? "—" : ingreso.ip) %>
        </div>
      </div>
      <% }); } else { %>
      <div class="px-8 py-12 text-center text-on-surface-variant">
        <p class="font-body">No hay ingresos registrados.</p>
      </div>
      <% } %>
    </div>
    </div>
    </div>
  </div>
  <div class="signature-divider mt-12"></div>
</main>
<%- include('../partials/admin-mobile-nav', { active: "ingresos" }) %>


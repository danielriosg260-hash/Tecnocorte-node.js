<%# Título: TecnoCorte - Mi Perfil %>

<%- include('../partials/peluquero-sidebar', { active: "perfil" }) %>
<main class="flex-1 md:ml-72 flex flex-col min-h-screen relative bg-background">
  <%- include('../partials/panel-header') %>

  <div class="p-6 md:p-12 space-y-12 max-w-5xl mx-auto w-full">
    
    <section
      class="flex flex-col md:flex-row justify-between items-end gap-6 border-b border-surface-container-low pb-8"
    >
      <div>
        <p class="tc-eyebrow mb-3">Mi cuenta</p>
        <h1 class="tc-display text-4xl md:text-5xl">
          Mi <span class="tc-gold-text">perfil</span>
        </h1>
        <p class="mt-3 text-on-surface-variant">
          Administra tus datos personales y revisa tus citas y reseñas.
        </p>
      </div>
      <button
        type="button"
        data-profile-edit="editar"
        class="tc-btn tc-btn--ghost"
      >
        <span class="material-symbols-outlined text-base">edit</span>Editar perfil
      </button>
    </section>

    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      
      <div class="tc-glass tc-glass--hover rounded-xl p-8 flex flex-col items-center text-center">
        <div
          class="w-28 h-28 rounded-full mb-6 bg-surface-container-highest border border-outline-variant/30 flex items-center justify-center overflow-hidden"
        >
          
          <% if (usuario.foto) { %>
          <img
            src="<%= usuario.foto.url %>"
            alt="<%= usuario.nombre %>"
            class="h-full w-full object-cover"
          />
          <% } else { %>
          <span class="material-symbols-outlined text-primary text-6xl"
            >content_cut</span
          >
          <% } %>
        </div>
        <h3 class="font-headline text-3xl font-bold tracking-tight mb-1">
          <%= usuario.nombre %> <%= usuario.apellido %>
        </h3>
        <p class="tc-eyebrow mt-1 mb-4">Barbero</p>

        <div class="w-full space-y-3 text-left text-sm">
          <p class="flex items-center gap-3 text-on-surface-variant">
            <span class="material-symbols-outlined text-primary text-base"
              >mail</span
            ><%= usuario.email %>
          </p>
          <p class="flex items-center gap-3 text-on-surface-variant">
            <span class="material-symbols-outlined text-primary text-base"
              >call</span
            ><%= ((usuario.telefono === undefined || usuario.telefono === null || usuario.telefono === '') ? "Sin registrar" : usuario.telefono) %>
          </p>
        </div>

        
        <div class="w-full mt-6 pt-6 border-t border-outline-variant/10">
          <div class="flex items-center justify-center gap-2 mb-2">
            <% var _lista62 = Array.from(String("12345")); if (_lista62.length) { _lista62.forEach(function (i, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista62.length - 1 }; var _finDeLista = _lista62.length - 1; %> <% if ((indice + 1) <= promedio) { %>
            <span
              class="material-symbols-outlined text-primary"
              style="font-variation-settings: &quot;FILL&quot; 1"
              >star</span
            >
            <% } else { %>
            <span class="material-symbols-outlined text-primary/30">star</span>
            <% } %> <% }); } %>
            <span class="font-headline text-2xl text-primary font-bold ml-2"
              ><%= ((promedio === undefined || promedio === null || promedio === '') ? "-" : promedio) %></span
            >
          </div>
          <p class="text-xs text-on-surface-variant text-center">
            <%= total_calificaciones %> reseña<%= (Number(total_calificaciones) === 1 ? '' : 's') %>
          </p>
        </div>
      </div>

      
      <div id="editar" class="hidden scroll-mt-28">
        <form
          method="post"
          enctype="multipart/form-data"
          class="tc-form tc-form__grid"
        >
          

          <div class="tc-field--full space-y-3">
            <p class="tc-eyebrow">Foto de perfil</p>
            <% if (usuario.foto) { %>
            <img
              src="<%= usuario.foto.url %>"
              alt="<%= usuario.nombre %>"
              class="h-20 w-20 rounded-full border border-primary/25 object-cover"
            />
            <% } %>
            <label class="tc-field tc-field--always">
              <input type="file" name="foto" accept="image/*" class="tc-field__input" />
              <span class="tc-field__label">Imagen (JPG, PNG o WEBP)</span>
            </label>
          </div>

          <label class="tc-field">
            <input
              required
              name="nombre"
              value="<%= usuario.nombre %>"
              placeholder=" "
              class="tc-field__input"
            />
            <span class="tc-field__label">Nombre</span>
          </label>

          <label class="tc-field">
            <input
              required
              name="apellido"
              value="<%= usuario.apellido %>"
              placeholder=" "
              class="tc-field__input"
            />
            <span class="tc-field__label">Apellido</span>
          </label>

          <label class="tc-field tc-field--full">
            <input
              type="tel"
              name="telefono"
              value="<%= usuario.telefono %>"
              placeholder=" "
              class="tc-field__input"
            />
            <span class="tc-field__label">Teléfono</span>
          </label>

          <div class="tc-form__actions">
            <button class="tc-btn tc-btn--gold" type="submit">
              <span class="material-symbols-outlined text-[18px]">save</span>
              Guardar cambios
            </button>
          </div>
        </form>
        <a
          href="/cambiar-password"
          class="tc-btn tc-btn--ghost mt-4 w-full"
          ><span class="material-symbols-outlined text-base">lock_reset</span
          >Cambiar contraseña</a
        >
      </div>
    </div>

    
    <% if (calificaciones && config.mostrar_calificaciones) { %>
    <section>
      <div
        class="flex justify-between items-end mb-8 border-b border-outline-variant/10 pb-4"
      >
        <h3 class="tc-display text-3xl">Reseñas de clientes</h3>
      </div>
      <div class="space-y-4">
        <% var _lista63 = (calificaciones || []); if (_lista63.length) { _lista63.forEach(function (cal, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista63.length - 1 }; var _finDeLista = _lista63.length - 1; %>
        <div class="tc-glass rounded-xl p-6">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center"
              >
                <span class="material-symbols-outlined text-primary text-lg"
                  >person</span
                >
              </div>
              <div>
                <p class="font-body text-on-surface font-semibold">
                  <%= cal.cliente.nombre %> <%= cal.cliente.apellido %>
                </p>
                <p class="text-xs text-on-surface-variant">
                  <%= fmtFecha(cal.fecha, "d/m/Y") %> · <%= (cal.reserva ? cal.reserva.servicio : '') %>
                </p>
              </div>
            </div>
            <div class="flex items-center gap-1">
              <% var _lista64 = Array.from(String("12345")); if (_lista64.length) { _lista64.forEach(function (i, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista64.length - 1 }; var _finDeLista = _lista64.length - 1; %> <% if ((indice + 1) <= cal.puntuacion) { %>
              <span
                class="material-symbols-outlined text-primary text-sm"
                style="font-variation-settings: &quot;FILL&quot; 1"
                >star</span
              >
              <% } else { %>
              <span class="material-symbols-outlined text-primary/30 text-sm"
                >star</span
              >
              <% } %> <% }); } %>
              <span class="font-bold text-primary text-sm ml-1"
                ><%= cal.puntuacion %></span
              >
            </div>
          </div>
          <% if (cal.comentario) { %>
          <p
            class="text-on-surface-variant text-sm mt-2 border-t border-outline-variant/10 pt-3"
          >
            <%= cal.comentario %>
          </p>
          <% } %>
        </div>
        <% }); } %>
      </div>
    </section>
    <% } %>

    
    <section>
      <div
        class="flex justify-between items-end mb-8 border-b border-outline-variant/10 pb-4"
      >
        <h3 class="tc-display text-3xl">Mis citas</h3>
        <a
          class="text-primary text-sm uppercase tracking-widest hover:text-primary-container transition-colors active:scale-95 flex items-center gap-1 group"
          href="/barbero/nueva-cita"
        >
          Nueva cita
          <span
            class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1"
            >arrow_forward</span
          >
        </a>
      </div>
      <div class="flex flex-col gap-4">
        <% var _lista65 = (citas || []); if (_lista65.length) { _lista65.forEach(function (cita, indice) { let forloop = { counter: indice + 1, counter0: indice, first: indice === 0, last: indice === _lista65.length - 1 }; var _finDeLista = _lista65.length - 1; %>
        <div class="tc-glass rounded-xl p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div class="flex items-start gap-4">
            <div
              class="flex flex-col items-center justify-center bg-surface-container-highest p-3 rounded-lg min-w-[70px]"
            >
              <span class="text-primary-container text-xs font-bold uppercase"
                ><%= fmtFecha(cita.fecha, "M") %></span
              >
              <span class="font-headline text-2xl text-on-surface"
                ><%= fmtFecha(cita.fecha, "d") %></span
              >
            </div>
            <div>
              <h4 class="font-headline text-xl mb-1"><%= cita.servicio %></h4>
              <p class="text-on-surface-variant text-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-[14px]">schedule</span
                ><%= fmtHora(cita.hora) %> · <%= cita.peluqueria.nombre %>
              </p>
              <p class="text-on-surface-variant text-sm">
                Cliente:
                <span class="text-on-surface"
                  ><%= cita.cliente.nombre %> <%= cita.cliente.apellido %></span
                >
              </p>
            </div>
          </div>
          <span
            class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest <% if (cita.estado == 'Completada') { %>bg-green-500/10 text-green-400 border border-green-500/20 <% } else if (cita.estado == 'Confirmada') { %>bg-primary/10 text-primary border border-primary/20 <% } else if (cita.estado == 'Cancelada') { %>bg-error/10 text-error border border-error/20 <% } else { %>bg-secondary-container/20 text-secondary border border-secondary-container/30<% } %>"
          >
            <%= cita.estado %>
          </span>
        </div>
        <% }); } else { %>
        <p class="font-body text-on-surface-variant">
          No tienes citas registradas.
        </p>
        <% } %>
      </div>
    </section>
  </div>
</main>
<%- include('../partials/peluquero-mobile-nav', { active: "perfil" }) %>

